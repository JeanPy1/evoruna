---
import Layout from "../layouts/Layout.astro";
import AuthShell from "../components/auth/AuthShell.astro";
import Loader from "../components/others/Loader.astro";
import Formulario from "../components/auth/Formulario.astro";
---

<Layout title="Nueva contraseña — Evoruna">
  <AuthShell withPanel={false} page="reset">
    <!-- Mientras se valida el token se muestra el loader -->
    <Loader />

    <div id="page" hidden>
      <Formulario
        title="Crear nueva contraseña"
        subtitle="Introduce una nueva contraseña para tu cuenta."
        fields={["password", "password-confirm"]}
        submitLabel="Cambiar contraseña"
        passwordLabel="Nueva contraseña"
        passwordHint="Mínimo 8 caracteres"
        footerLinkText="Volver al login"
        footerHref="/login"
      />
    </div>
  </AuthShell>

  <!-- SIN type="module": Astro solo bunea scripts sin atributos extra.
       La lógica vive en src/scripts/auth-pages.js -->
  <script src="../scripts/auth-pages.js"></script>
</Layout>
