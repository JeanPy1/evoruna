---
import Layout from "../layouts/Layout.astro";
import AuthShell from "../components/auth/AuthShell.astro";
---

<Layout title="Verificar correo — Evoruna">
  <AuthShell withPanel={false} page="verify-email">
    <div id="page" class="relative w-full rounded-2xl border border-white/10 bg-white/[0.06] p-8 text-center shadow-[0_32px_80px_-32px_rgba(0,0,0,0.65)] backdrop-blur-xl">

      <!-- Hairline rojo superior -->
      <span
        class="absolute inset-x-8 top-0 h-px bg-gradient-to-r from-transparent via-electric/50 to-transparent"
        aria-hidden="true"
      ></span>

      <div id="estado-carga" class="flex flex-col items-center gap-4">
        <div class="h-10 w-10 animate-spin rounded-full border-4 border-white/10 border-t-electric"></div>
        <h1 class="font-display text-lg font-bold tracking-tight text-white">Verificando tu correo...</h1>
        <p class="text-sm text-slate-400">Un momento, estamos activando tu cuenta.</p>
      </div>

      <div id="estado-exito" class="hidden flex-col items-center gap-4">
        <div class="flex h-12 w-12 items-center justify-center rounded-full bg-neon/15 text-neon">
          <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
        </div>
        <h1 class="font-display text-lg font-bold tracking-tight text-white">Correo verificado</h1>
        <p class="text-sm text-slate-400">Tu cuenta está activa. Te llevamos al inicio de sesión...</p>
      </div>

      <div id="estado-error" class="hidden flex-col items-center gap-4">
        <div class="flex h-12 w-12 items-center justify-center rounded-full bg-electric/15 text-electric-light">
          <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </div>
        <h1 class="font-display text-lg font-bold tracking-tight text-white">No se pudo verificar tu correo</h1>
        <p id="error-mensaje" class="text-sm text-slate-400">El enlace es inválido o ha expirado.</p>
        <a href="/login" class="btn-primary mt-2">
          Ir al inicio de sesión
        </a>
      </div>

    </div>
  </AuthShell>

  <!-- SIN type="module": Astro solo bunea scripts sin atributos extra.
       La lógica vive en src/scripts/auth-pages.js -->
  <script src="../scripts/auth-pages.js"></script>
</Layout>
