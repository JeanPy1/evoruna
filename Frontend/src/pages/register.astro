---
import Layout from "../layouts/Layout.astro";
import AuthShell from "../components/auth/AuthShell.astro";
import Panel from "../components/auth/Panel.astro";
import Formulario from "../components/auth/Formulario.astro";
---

<Layout title="Crear cuenta — Evoruna">
  <AuthShell page="register">
    <Panel slot="panel" />

    <Formulario
      title="Crear cuenta"
      subtitle="Comienza a gestionar tu sitio."
      submitLabel="Crear cuenta"
      passwordHint="Mínimo 4 caracteres"
      footerText="¿Ya tienes cuenta?"
      footerLinkText="Inicia sesión"
      footerHref="/login"
    />
  </AuthShell>

  <!-- SIN type="module": Astro solo bunea scripts sin atributos extra.
       La lógica vive en src/scripts/auth-pages.js -->
  <script src="../scripts/auth-pages.js"></script>
</Layout>
