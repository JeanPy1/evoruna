---
import Layout from "../layouts/Layout.astro";
import Panel from "../components/auth/Panel.astro";
import Formulario from "../components/auth/Formulario.astro";

// Misma origen por defecto: todo se sirve desde el mismo Worker de Cloudflare
const API_URL = import.meta.env.PUBLIC_API_URL ?? "/api";
---

<Layout>
  <main id="page" class="min-h-screen bg-gradient-to-br from-slate-50 via-white to-blue-50/50">
    <div class="flex min-h-screen items-center justify-center px-4 py-10 sm:px-6">
      <div class="relative z-10 mx-auto grid w-full max-w-6xl items-center gap-12 lg:grid-cols-2">
        <Panel />

        <Formulario
          title="Crear cuenta"
          subtitle="Comienza a gestionar tu sitio."
          submitLabel="Crear cuenta"
          passwordHint="Mínimo 8 caracteres"
          footerText="¿Ya tienes cuenta?"
          footerLinkText="Inicia sesión"
          footerHref="/login"
        />
      </div>
    </div>
  </main>
</Layout>

<script define:vars={{ API_URL }} type="module">
  import { MESSAGES, readJson, redirectIfAuthenticated } from "../scripts/auth.js";

  const form = document.getElementById("form");
  const nameInput = document.getElementById("name");
  const emailInput = document.getElementById("email");
  const passwordInput = document.getElementById("password");
  const confirmInput = document.getElementById("password-confirm");
  const submitButton = document.getElementById("submit");

  form.addEventListener("submit", async (event) => {
    event.preventDefault();

    const name = nameInput.value.trim();
    const email = emailInput.value.trim();
    const password = passwordInput.value.trim();
    const confirmPassword = confirmInput.value.trim();

    if (!name || !email || !password || !confirmPassword) {
      showAuthMessage(MESSAGES.incomplete);
      return;
    }

    if (password !== confirmPassword) {
      showAuthMessage(MESSAGES.mismatch);
      return;
    }

    const label = submitButton.textContent;
    submitButton.disabled = true;
    submitButton.textContent = "Creando cuenta...";

    try {
      const response = await fetch(`${API_URL}/auth/register`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ name, email, password }),
      });

      const data = await readJson(response);

      if (response.ok) {
        form.reset();
        showAuthMessage(MESSAGES.email_sent);
        return;
      }

      showAuthMessage({ type: "error", text: data.error || MESSAGES.register_failed.text });
    } catch {
      showAuthMessage(MESSAGES.network);
    } finally {
      submitButton.disabled = false;
      submitButton.textContent = label;
    }
  });

  void redirectIfAuthenticated(API_URL);
</script>
