---
// Evoruna — Tickets del área de cliente.
import Layout from "../../layouts/Layout.astro";
import Shell from "../../components/dashboard/Shell.astro";

const filters = [
  { id: "all", label: "Todos" },
  { id: "open", label: "Abiertos" },
  { id: "progress", label: "En progreso" },
  { id: "resolved", label: "Resueltos" },
];

const inputClass =
  "w-full rounded-[12px] border border-white/10 bg-navy-800/60 px-3.5 py-2.5 text-sm text-white outline-none transition-colors duration-200 placeholder:text-slate-500 focus:border-electric/50";
const labelClass = "mb-1.5 block text-xs font-semibold text-slate-300";
---

<Layout title="Tickets — Evoruna">

  <Shell active="tickets">

    <!-- Encabezado -->
    <header class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">

      <div>
        <h1 class="font-display text-2xl font-bold text-white sm:text-3xl">Tickets</h1>
        <p class="mt-2 text-sm text-slate-400">
          Solicita cambios o reporta problemas. Nuestro equipo responde en menos de 24 h.
        </p>
      </div>

      <button data-open-ticket-form class="btn-primary">
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
        Nuevo ticket
      </button>
    </header>

    <!-- Formulario (demo) -->
    <section id="new-ticket-panel" class="mt-6 hidden">

      <form
        id="new-ticket-form"
        class="relative overflow-hidden rounded-2xl border border-white/[0.14] bg-gradient-to-b from-white/[0.10] via-white/[0.06] to-white/[0.05] p-6 backdrop-blur-xl sm:p-7"
      >

        <span class="absolute inset-x-10 top-0 h-[2px] bg-gradient-to-r from-transparent via-electric/70 to-transparent" aria-hidden="true"></span>

        <h2 class="font-display text-lg font-semibold text-white">Nuevo ticket</h2>
        <p class="mt-1 text-sm text-slate-400">
          Cuéntanos qué necesitas. Un agente te asignará en menos de 24 h.
        </p>

        <div class="mt-5 grid gap-4 sm:grid-cols-2">

          <label class="block sm:col-span-2">
            <span class={labelClass}>Asunto</span>
            <input name="subject" required maxlength="120" placeholder="Ej.: Cambiar el texto del encabezado" class={inputClass} />
          </label>

          <label class="block">
            <span class={labelClass}>Categoría</span>
            <select name="category" class={inputClass}>
              <option>Cambio de contenido</option>
              <option>Diseño</option>
              <option>Bug</option>
              <option>Técnico</option>
              <option>Facturación</option>
              <option>Otro</option>
            </select>
          </label>

          <label class="block">
            <span class={labelClass}>Prioridad</span>
            <select name="priority" class={inputClass}>
              <option>Baja</option>
              <option selected>Media</option>
              <option>Alta</option>
            </select>
          </label>

          <label class="block sm:col-span-2">
            <span class={labelClass}>Descripción</span>
            <textarea name="description" rows="4" required placeholder="Describe el cambio o el problema con el mayor detalle posible." class={inputClass}></textarea>
          </label>
        </div>

        <div class="mt-6 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">

          <button type="button" data-close-ticket-form class="btn-ghost-dark">Cancelar</button>
          <button type="submit" class="btn-primary">Enviar ticket</button>
        </div>
      </form>
    </section>

    <!-- Filtros + lista -->
    <section class="mt-6">

      <div class="flex flex-wrap items-center gap-2">
        {
          filters.map((filter, i) => (
            <button
              data-filter={filter.id}
              class:list={[
                "rounded-full border px-3.5 py-1.5 text-xs font-semibold transition-colors duration-200",
                i === 0
                  ? "border-white/25 bg-white/10 text-white"
                  : "border-white/10 text-slate-400 hover:text-white",
              ]}
            >
              {filter.label}
            </button>
          ))
        }
      </div>

      <div class="mt-4 overflow-hidden rounded-2xl border border-white/10 bg-white/[0.05] backdrop-blur-xl">

        <div class="flex items-center justify-between border-b border-white/[0.06] px-5 py-4">

          <h2 class="font-display text-base font-semibold text-white">Tus tickets</h2>
          <span id="ticket-count" class="text-xs text-slate-400"></span>
        </div>

        <!-- Lo llena dashboard-ui.js -->
        <ul id="ticket-list" data-count="0" class="divide-y divide-white/[0.05]">
          <li class="px-5 py-6 text-sm text-slate-500">
            <span class="inline-flex items-center gap-2">
              <span class="size-1.5 animate-pulse rounded-full bg-electric/60"></span>
              Cargando tickets…
            </span>
          </li>
        </ul>
      </div>
    </section>
  </Shell>

  <script src="../../scripts/dashboard-ui.js"></script>
</Layout>
