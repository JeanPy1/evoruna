---
import Layout from "../layouts/Layout.astro";
import AuthShell from "../components/auth/AuthShell.astro";
import Panel from "../components/auth/Panel.astro";
import Formulario from "../components/auth/Formulario.astro";
---

<Layout title="Iniciar sesión — Evoruna">
  <AuthShell page="login">
    <Panel slot="panel" />

    <Formulario
      title="Iniciar sesión"
      subtitle="Accede a tu cuenta"
      fields={["email", "password"]}
      submitLabel="Entrar"
      forgotLink
      footerText="¿No tienes cuenta?"
      footerLinkText="Regístrate"
      footerHref="/register"
    />
  </AuthShell>

  <!-- SIN type="module": Astro solo bunea scripts sin atributos extra.
       La lógica (login, banners, redirects) vive en src/scripts/auth-pages.js -->
  <script src="../scripts/auth-pages.js"></script>
</Layout>
