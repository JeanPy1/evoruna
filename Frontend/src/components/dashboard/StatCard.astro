---
// Evoruna — Tarjeta de estadística del resumen.
// El icono se pasa por slot ("icon").
interface Props {
  label: string;
  value: string;
  sub?: string;
  tone?: "neon" | "electric" | "default";
  href?: string;
  /** data-attribute para que dashboard-ui.js actualice el valor desde la API. */
  dataValue?: string;
  /** data-attribute para que dashboard-ui.js actualice el texto secundario. */
  dataSub?: string;
}

const { label, value, sub, tone = "default", href, dataValue, dataSub } = Astro.props;

const valueTone = {
  neon: "text-neon-light",
  electric: "text-electric-light",
  default: "text-white",
}[tone];

const Wrapper = href ? "a" : "div";
---

<Wrapper
  href={href}
  class:list={[
    "group relative overflow-hidden rounded-2xl border border-white/10 bg-white/[0.05] p-5 backdrop-blur-xl transition-colors duration-200",
    href && "hover:border-white/25",
  ]}
>

  <div class="flex items-center justify-between gap-3">
    <p class="text-[0.7rem] font-bold tracking-[0.14em] text-slate-400 uppercase">{label}</p>
    <slot name="icon" />
  </div>

  <p data-value={dataValue} class:list={["mt-3 font-display text-[1.55rem] leading-tight font-bold", valueTone]}>{value}</p>

  {sub && <p data-sub={dataSub} class="mt-1 truncate text-[0.8rem] text-slate-400">{sub}</p>}
</Wrapper>
