---
import Icon from "./Icon.astro";

const {apiUrl} = Astro.props;
---

<style>

  .dashboard-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
    padding: 1rem 0 4rem;
  }

  .dashboard-header-left {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .dashboard-title {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .dashboard-label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: max-content;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    background: rgba(79, 70, 229, 0.08);
    color: rgb(79 70 229);
    font-size: 0.82rem;
    font-weight: 600;
  }

  .dashboard-label svg {
    width: 16px;
    height: 16px;
  }

  .dashboard-greeting {
    font-size: 2.6rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.1;
    color: rgb(15 23 42);
  }

  .dashboard-name {
    background: linear-gradient(135deg, #4f46e5, #2563eb);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .dashboard-subtitle {
    max-width: 42rem;
    color: rgb(100 116 139);
    font-size: 1rem;
    line-height: 1.7;
  }

  .dashboard-header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .dashboard-sites {    
    margin-top: .5rem;
    overflow: hidden;
  }

  .dashboard-sites[hidden] {
    display: none;
  }

  .dashboard-sites-list {
    display: flex;
    flex-wrap: wrap;
    gap: .65rem;
    max-width: 100%;
    overflow: visible;
    padding: .1rem .15rem .45rem;
  }

  :global(.dashboard-site-card) {
    position: relative;
    min-width: 11.5rem;
    display: grid;
    gap: .35rem;
    padding: .72rem .78rem .72rem .95rem;
    overflow: hidden;
    border-radius: .95rem;
    border: 1px solid rgba(226, 232, 240, .95);
    background:
      linear-gradient(180deg, rgba(255,255,255,.98), rgba(248,250,252,.92));
    color: rgb(51 65 85);
    text-align: left;
    cursor: pointer;
    box-shadow:
      0 8px 18px rgba(15, 23, 42, .035),
      inset 0 1px 0 rgba(255,255,255,.75);
    transition:
      transform .25s ease,
      border-color .25s ease,
      background .25s ease,
      box-shadow .25s ease,
      color .25s ease;
  }

  :global(.dashboard-site-card)::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 4px;
    background: rgb(203 213 225);
  }

  :global(.dashboard-site-card:hover) {
    transform: translateY(-2px);
    border-color: rgba(79, 70, 229, .22);
    box-shadow:
      0 10px 22px rgba(15, 23, 42, .055),
      inset 0 1px 0 rgba(255,255,255,.8);
  }

  :global(.dashboard-site-card.is-active) {
    transform: translateY(-2px);
    border-color: rgba(79, 70, 229, .28);
    background:
      linear-gradient(180deg, rgb(238 242 255), rgb(224 231 255));
    color: rgb(49 46 129);
    box-shadow:
      0 10px 22px rgba(79, 70, 229, .08),
      inset 0 1px 0 rgba(255,255,255,.85);
  }

  :global(.dashboard-site-card.is-active)::before {
    background: rgb(79 70 229);
    box-shadow: none;
  }

  :global(.dashboard-site-domain) {
    position: relative;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    padding-right: 0;
    font-size: .9rem;
    font-weight: 800;
    letter-spacing: -.01em;
  }

  :global(.dashboard-site-status) {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    width: max-content;
    padding: .2rem .48rem;
    border-radius: 999px;
    background: rgb(241 245 249);
    color: rgb(100 116 139);
    font-size: .68rem;
    font-weight: 800;
  }

  :global(.dashboard-site-status)::before {
    content: "";
    width: .42rem;
    height: .42rem;
    border-radius: 999px;
    background: rgb(148 163 184);
  }

  :global(.dashboard-site-card.is-active .dashboard-site-status) {
    background: rgba(79, 70, 229, .1);
    color: rgb(67 56 202);
  }

  :global(.dashboard-site-card.is-active .dashboard-site-status)::before {
    background: rgb(34 197 94);
    box-shadow: none;
  }

  .dashboard-logout {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1.35rem;
    border-radius: 1rem;
    border: 1px solid rgba(226, 232, 240, 0.9);
    background: white;
    color: rgb(51 65 85);
    cursor: pointer;
    font-weight: 600;
    white-space: nowrap;
    transition:
      transform .3s ease,
      border-color .3s ease,
      box-shadow .3s ease,
      background .3s ease,
      color .3s ease;
  }

  .dashboard-logout:hover {
    transform: translateY(-2px);
    color: rgb(220 38 38);
    border-color: rgba(220, 38, 38, 0.25);
    background: rgba(254, 242, 242, 0.9);
    box-shadow: 0 2px 28px rgba(220, 38, 38, 0.1);
  }

  .dashboard-logout svg {
    width: 18px;
    height: 18px;
    fill: rgb(79 70 229);
    transition: fill 0.3s ease;
  }

  .dashboard-logout:hover svg {
    fill: rgb(220 38 38);
  }

  @media (max-width: 600px) {

    .dashboard-header {    
      flex-direction: column;
      gap: 2.5rem;
    }

    .dashboard-title {
      align-items: stretch;
    }

    .dashboard-subtitle {
      text-align: left;
    }

    .dashboard-greeting {
      font-size: 2rem;
    }

    .dashboard-header-actions {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
    }

    .dashboard-sites {   
      flex-direction: column;   
      margin: 0 auto;
    }

    .dashboard-sites-list {
      display: flex;      
      flex-wrap: wrap;
      overflow: visible;
      padding-right: .15rem;
    }

    :global(.dashboard-site-card) {
      min-width: 11.5rem;
      width: auto;
    }

    .dashboard-logout {
      margin: 0 auto;
    }

  }

@media (max-width: 440px) {
  .dashboard-sites-list {
    flex-direction: column;
  } 
}
  

</style>

<header class="dashboard-header">
  <div class="dashboard-header-left">
    <div class="dashboard-title">
      <span class="dashboard-label">
        <Icon name="check-circle" size="18" strokeWidth="2.4" />

        Panel de administraci&oacute;n
      </span>

      <h1 class="dashboard-greeting">
        Hola,
        <span id="dashboard-name" class="dashboard-name"> Usuario </span>
      </h1>

      <p class="dashboard-subtitle">
        Administra tu sitio web, revisa el estado de tus servicios y solicita
        cambios cuando lo necesites.
      </p>

      <div id="dashboard-sites" class="dashboard-sites" hidden>
        <div id="dashboard-sites-list" class="dashboard-sites-list"></div>
      </div>
    </div>
  </div>

  <button id="logout" class="dashboard-logout">
    <Icon name="logout" viewBox="0 0 512 512" />

    <span> Cerrar sesi&oacute;n </span>
  </button>
</header>

<script define:vars={{ apiUrl }} type="module">

  const logoutButton =  document.getElementById("logout");
  logoutButton?.addEventListener("click", logout);

  async function logout(){

    try {

      const response = await fetch(`${apiUrl}/auth/logout`, {
        method: "POST",
        credentials: "include"
      });
    
      if (response.ok){
        sessionStorage.removeItem("evoruna_session_hint");
        showToast("Cerrando sesion.", "success");       
          
        setTimeout(() => {
          window.location.replace("/login");
        }, 2000);   
      }  

    } catch(error){
    }   

  }

</script>
