---
import Icon from "./Icon.astro";
import DashboardSection from "./DashboardSection.astro";
---

<style>
  .dashboard-services {
    display: grid;
    gap: 1.5rem;
  }

  .dashboard-service {
    display: grid;
    gap: 1rem;
  }

  .dashboard-service-title {
    font-size: 1rem;
    font-weight: 800;
    color: rgb(15 23 42);
  }

  .dashboard-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
  }

  .dashboard-card {
    position: relative;
    overflow: hidden;
    padding: 2rem;
    border-radius: 1.5rem;
    background: white;
    border: 1px solid rgb(226 232 240);
    transition:
      transform 0.35s ease,
      border-color 0.35s ease,
      box-shadow 0.35s ease;
  }

  .dashboard-card:hover {
    transform: translateY(-5px);
    border-color: rgba(79, 70, 229, .18);
    box-shadow: 0 18px 38px rgba(15, 23, 42, .08);
  }

  .dashboard-card::before {
    content: "";
    position: absolute;
    inset: 0 auto auto 0;
    width: 100%;
    height: 4px;
  }

  .dashboard-card.blue::before {
    background: linear-gradient(90deg, #2563eb, #3b82f6);
  }

  .dashboard-card.green::before {
    background: linear-gradient(90deg, #16a34a, #22c55e);
  }

  .dashboard-card.amber::before {
    background: linear-gradient(90deg, #d97706, #f59e0b);
  }

  .dashboard-card.purple::before {
    background: linear-gradient(90deg, #7c3aed, #a855f7);
  }

  .dashboard-card-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 18px;
    color: white;
  }

  .dashboard-card-icon.blue {
    background: linear-gradient(135deg, #2563eb, #3b82f6);
  }

  .dashboard-card-icon.green {
    background: linear-gradient(135deg, #16a34a, #22c55e);
  }

  .dashboard-card-icon.amber {
    background: linear-gradient(135deg, #d97706, #f59e0b);
  }

  .dashboard-card-icon.purple {
    background: linear-gradient(135deg, #7c3aed, #a855f7);
  }

  .dashboard-card-label {
    margin-top: 1.4rem;
    font-size: .9rem;
    color: rgb(100 116 139);
  }

  .dashboard-card-value {
    margin-top: .35rem;
    font-size: 1.45rem;
    font-weight: 700;
    color: rgb(15 23 42);
  }

  .dashboard-card-info {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    margin-top: 1rem;
    font-size: .9rem;
    font-weight: 600;
    color: rgb(79 70 229);
  }

  .dashboard-empty {
    padding: 2rem;
    border-radius: 1.5rem;
    background: white;
    border: 1px dashed rgb(203 213 225);
    color: rgb(100 116 139);
    line-height: 1.7;
  }

  .dashboard-empty strong {
    display: block;
    margin-bottom: .35rem;
    color: rgb(15 23 42);
    font-size: 1.05rem;
  }
</style>

<DashboardSection
  title="Resumen del servicio"
  subtitle="Estado actual, plan y datos principales del sitio."
>
  <div id="dashboard-services" class="dashboard-services">
    <div class="dashboard-empty">
      <strong>Sin servicios activos</strong>
      Aun no hay sitios web asociados a tu cuenta. Cuando tengas un servicio,
      su resumen aparecera aqui.
    </div>
  </div>

  <template id="dashboard-service-template">
    <article class="dashboard-service">
      <div class="dashboard-grid">
        <article class="dashboard-card blue">
          <div class="dashboard-card-icon blue">
            <Icon name="menu-lines" size="24" />
          </div>
          <p class="dashboard-card-label">Mi sitio</p>
          <h3 class="dashboard-card-value" data-service-domain></h3>
          <span class="dashboard-card-info" data-service-status></span>
        </article>

        <article class="dashboard-card amber">
          <div class="dashboard-card-icon amber">
            <Icon name="star" size="24" />
          </div>
          <p class="dashboard-card-label">Plan actual</p>
          <h3 class="dashboard-card-value" data-service-plan></h3>
          <span class="dashboard-card-info" data-service-plan-info></span>
        </article>

        <article class="dashboard-card green">
          <div class="dashboard-card-icon green">
            <Icon name="edit" size="24" />
          </div>
          <p class="dashboard-card-label">Cambios disponibles</p>
          <h3 class="dashboard-card-value" data-service-changes></h3>
          <span class="dashboard-card-info">Restantes este mes</span>
        </article>

        <article class="dashboard-card purple">
          <div class="dashboard-card-icon purple">
            <Icon name="card" size="24" />
          </div>
          <p class="dashboard-card-label">Proxima renovacion</p>
          <h3 class="dashboard-card-value" data-service-renewal></h3>
          <span class="dashboard-card-info" data-service-renewal-info></span>
        </article>
      </div>
    </article>
  </template>
</DashboardSection>
