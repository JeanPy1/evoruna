---
const { title, subtitle, class: className = "" } = Astro.props;
---

<section class={`dashboard-section ${className}`}>
  <div class="dashboard-section-header">
    <h2 class="dashboard-section-title">{title}</h2>
    <p class="dashboard-section-subtitle">{subtitle}</p>
  </div>

  <slot />
</section>

<style>
  .dashboard-section {
    padding: 4rem 0;
  }

  .dashboard-section:not(:last-child) {
    border-bottom: 1px solid rgb(226 232 240);
  }

  .dashboard-section-header {
    margin-bottom: 2.5rem;
  }

  .dashboard-section-title {
    font-size: 1.7rem;
    font-weight: 800;
    color: rgb(15 23 42);
  }

  .dashboard-section-subtitle {
    margin-top: 0.4rem;
    color: rgb(100 116 139);
  }

  @media (max-width: 768px) {
    .dashboard-section {
      padding: 3rem 0;
    }
  }
</style>
