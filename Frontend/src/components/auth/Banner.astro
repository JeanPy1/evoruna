---
// Aviso superior para las pantallas de autenticación, adaptado al fondo navy:
// glass oscuro con tinte de color por tipo de aviso.
// Se muestra desde el script de la página con: showAuthMessage({ type, text })
// Tipos: "success" (neón), "error" (eléctrico), "warning" (ámbar), "info" (neutro).
---

<style>
  /* Banner SUPERPUESTO: position absolute sobre la card (que es relative),
     alineado al borde superior del área de contenido. Al aparecer cubre la
     zona del título/subtítulo SIN empujar ningún componente (cero shift de
     layout). Por eso el fondo es sólido: detrás queda el header de la card. */
  .auth-banner {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 20;
    display: none;
    align-items: flex-start;
    gap: 0.65rem;
    padding: 0.75rem 0.9rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 0.75rem;
    background-color: rgba(13, 20, 36, 0.94);
    box-shadow: 0 12px 32px -8px rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    font-size: 0.9rem;
    font-weight: 500;
    line-height: 1.45;
    opacity: 0;
    transform: translateY(-6px);
    transition:
      opacity 0.25s ease,
      transform 0.25s ease;
  }

  /* .show deja el banner visible; @starting-style aporta el estado "desde"
     para la transición de entrada (sin depender de requestAnimationFrame).
     En navegadores sin @starting-style el banner simplemente aparece. */
  .auth-banner.show {
    display: flex;
    opacity: 1;
    transform: translateY(0);

    @starting-style {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  .auth-banner__icon {
    flex-shrink: 0;
    display: inline-flex;
    margin-top: 0.1rem;
  }

  .auth-banner__icon svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .auth-banner__text {
    flex: 1;
  }

  .auth-banner__close {
    flex-shrink: 0;
    margin-top: 0.15rem;
    padding: 0.1rem;
    display: inline-flex;
    cursor: pointer;
    border: none;
    border-radius: 0.35rem;
    background: transparent;
    color: inherit;
    opacity: 0.6;
    transition: opacity 0.15s ease;
  }

  .auth-banner__close:hover {
    opacity: 1;
  }

  .auth-banner__close svg {
    width: 1rem;
    height: 1rem;
  }

  /* El tinte por tipo va en background-image: la base (background-color)
     es sólida porque el banner queda superpuesto sobre el header de la card. */
  .auth-banner.success {
    background-image: linear-gradient(135deg, hsl(142 71% 45% / 0.16), transparent 60%);
    border-color: hsl(142 71% 45% / 0.35);
    color: hsl(142 65% 64%);
  }

  .auth-banner.error {
    background-image: linear-gradient(135deg, hsl(0 84% 50% / 0.18), transparent 60%);
    border-color: hsl(0 84% 50% / 0.4);
    color: hsl(0 90% 74%);
  }

  .auth-banner.warning {
    background-image: linear-gradient(135deg, hsl(43 96% 56% / 0.16), transparent 60%);
    border-color: hsl(43 96% 56% / 0.35);
    color: hsl(43 96% 72%);
  }

  .auth-banner.info {
    background-image: linear-gradient(135deg, hsl(214 32% 80% / 0.10), transparent 60%);
    border-color: rgba(255, 255, 255, 0.15);
    color: hsl(214 32% 80%);
  }
</style>

<div id="auth-banner" class="auth-banner" role="alert" aria-live="polite">
  <span class="auth-banner__icon"></span>
  <span class="auth-banner__text"></span>
  <button type="button" class="auth-banner__close" aria-label="Cerrar aviso">
    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
    </svg>
  </button>
</div>

<script type="module">
  const ICONS = {
    success: `<svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>`,
    error: `<svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 9.75l4.5 4.5m0-4.5l-4.5 4.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>`,
    warning: `<svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"></path></svg>`,
    info: `<svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z"></path></svg>`,
  };

  const banner = document.getElementById("auth-banner");
  const iconEl = banner.querySelector(".auth-banner__icon");
  const textEl = banner.querySelector(".auth-banner__text");

  // Auto-ocultado: el mensaje desaparece solo tras AUTO_HIDE_MS (también se
  // puede cerrar antes con la X). Mientras el cursor está sobre el banner la
  // cuenta se pausa para no borrarlo en cuanto se empieza a leer.
  const AUTO_HIDE_MS = 5000;
  const AUTO_HIDE_RESUME_MS = 1500;
  let autoHideTimer = null;

  function scheduleAutoHide(delay = AUTO_HIDE_MS) {
    if (autoHideTimer) clearTimeout(autoHideTimer);
    autoHideTimer = setTimeout(() => {
      autoHideTimer = null;
      hideAuthMessage();
    }, delay);
  }

  function showAuthMessage({ type = "info", text = "" } = {}) {
    const resolved = ICONS[type] ? type : "info";
    banner.className = "auth-banner " + resolved;
    iconEl.innerHTML = ICONS[resolved];
    textEl.textContent = text;
    // La animación de entrada la resuelve el CSS (@starting-style),
    // así la visibilidad no depende de requestAnimationFrame.
    banner.classList.add("show");
    scheduleAutoHide();
  }

  function hideAuthMessage() {
    if (autoHideTimer) clearTimeout(autoHideTimer);
    autoHideTimer = null;
    banner.classList.remove("show");
  }

  // Pausa el auto-ocultado mientras el cursor está sobre el banner
  banner.addEventListener("mouseenter", () => {
    if (autoHideTimer) clearTimeout(autoHideTimer);
    autoHideTimer = null;
  });
  banner.addEventListener("mouseleave", () => {
    if (banner.classList.contains("show") && !autoHideTimer) {
      scheduleAutoHide(AUTO_HIDE_RESUME_MS);
    }
  });

  banner.querySelector(".auth-banner__close").addEventListener("click", hideAuthMessage);

  window.showAuthMessage = showAuthMessage;
  window.hideAuthMessage = hideAuthMessage;
</script>
