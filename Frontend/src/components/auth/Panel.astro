---
// Panel de marca para las pantallas de autenticación (columna izquierda,
// solo en desktop). Mismo lenguaje que las secciones oscuras del landing:
// heading Sora en blanco con degradado rojo, checks neón y status "en vivo".

const defaults = {
  title: "Tú enfócate en crecer",
  titleHighlight: "nosotros en mantener",
  subtitle: "Nosotros nos encargamos de la parte técnica para que tú te enfoques en hacer crecer tu proyecto.",
  benefits: [
    "Tu sitio siempre online, nosotros lo vigilamos",
    "Soporte humano cuando lo necesitas",
    "Actualizaciones y backups sin que pienses en ello",
  ],
  status: "Plataforma activa 24/7",
  footer: {
    prefix: "Más de",
    highlight: "500 sitios",
    suffix: "bajo gestión activa",
  },
};

interface Props {
  content?: Partial<typeof defaults>;
}

const props = Astro.props;

const content = {
  ...defaults,
  ...props.content,
  footer: { ...defaults.footer, ...(props.content?.footer ?? {}) },
};
---

<aside class="hidden max-w-2xl lg:flex lg:flex-col lg:justify-center">

  <!-- Heading -->
  <h1
    class="font-display text-[2.6rem] leading-[1.06] font-extrabold tracking-[-0.03em] text-white sm:text-[2.9rem]"
  >
    {content.title}
    <span class="text-electric-gradient">{content.titleHighlight}</span>
  </h1>

  <!-- Descripción -->
  <p class="mt-5 max-w-xl text-lg leading-relaxed text-slate-400">{content.subtitle}</p>

  <!-- Beneficios con check neón -->
  <ul class="mt-9 flex flex-col gap-4">
    {
      content.benefits.map((benefit) => (
        <li class="flex items-center gap-3 text-[1.05rem] text-slate-300">
          <span
            class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-neon/15 text-neon">
            <svg
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              viewBox="0 0 24 24"
              width="14"
              height="14"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
            </svg>
          </span>
          {benefit}
        </li>
      ))
    }
  </ul>

  <!-- Pie: status "en vivo" + gestión activa -->
  <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-white/10 pt-6">

    <span class="flex items-center gap-2.5 text-sm font-medium text-slate-400">
      <span class="relative flex h-2 w-2">
        <span
          class="absolute inline-flex h-full w-full rounded-full bg-neon/60 motion-safe:animate-ping"
        ></span>
        <span class="relative inline-flex h-2 w-2 rounded-full bg-neon"></span>
      </span>
      {content.status}
    </span>

    <span class="text-sm text-slate-500">
      {content.footer.prefix}
      <span class="font-semibold text-white">{content.footer.highlight}</span>
      {content.footer.suffix}
    </span>

  </div>

</aside>
