---
import heroImage1 from "../../assets/bg.webp";
import heroImage1Fallback from "../../assets/bg.png";

const badges = [
  {
    icon: "star",
    label: "4.9/5 · Valoración",
  },
  {
    icon: "shield",
    label: "SSL y hosting incluidos",
  },
  {
    icon: "users",
    label: "Soporte humano",
  },
];

const stats = [
  { value: "1200+", label: "Sitios gestionados" },
  { value: "99.9%", label: "Uptime garantizado" },
  { value: "<24h", label: "Tiempo de respuesta" },
  { value: "24/7", label: "Monitoreo activo" },
];
---

<section
  id="home"
  class="relative flex min-h-[100svh] items-center overflow-hidden bg-navy pt-28 pb-20 text-white"
  data-theme="dark"
>
  <!-- Foto full-bleed -->
  <picture class="absolute inset-0" aria-hidden="true">
    <source srcset={heroImage1.src} type="image/webp" />
    <img
      src={heroImage1Fallback.src}
      width={heroImage1Fallback.width}
      height={heroImage1Fallback.height}
      alt=""
      class="h-full w-full object-cover"
      decoding="async"
    />
  </picture>

  <!-- Overlay navy con tinte rojo (degradado firma) -->
  <div class="hero-overlay absolute inset-0" aria-hidden="true"></div>

  <!-- Brillo rojo inferior derecho -->
  <div
    class="pointer-events-none absolute -right-24 -bottom-32 h-[28rem] w-[28rem] rounded-full bg-electric/10 blur-[120px]"
    aria-hidden="true"
  ></div>

  <div class="container-x relative">

    <!-- Badges -->
    <div
      class="hero-enter flex flex-wrap items-center gap-2.5"
    >
      {
        badges.map((badge) => (
          <span class="kicker kicker-dark !px-3 !py-1.5 !text-[0.68rem]">
            {
              badge.icon === "star" && (
                <svg class="size-3.5 text-electric-light" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 2l2.9 6.26 6.6.57-5 4.4 1.5 6.47L12 16.9 5.99 19.7l1.5-6.47-5-4.4 6.6-.57L12 2z" />
                </svg>
              )
            }
            {
              badge.icon === "shield" && (
                <svg class="size-3.5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 3l7 4v5c0 5-3.5 8-7 9-3.5-1-7-4-7-9V7l7-4z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9.5 12l1.8 1.8L15 10" />
                </svg>
              )
            }
            {
              badge.icon === "users" && (
                <svg class="size-3.5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2" />
                  <circle cx="9" cy="7" r="4" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M22 21v-2a4 4 0 00-3-3.87" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16 3.13a4 4 0 010 7.75" />
                </svg>
              )
            }
            {
              badge.icon === "clock" && (
                <svg class="size-3.5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="12" cy="12" r="9" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 7v5l3 2" />
                </svg>
              )
            }
            {badge.label}
          </span>
        ))
      }
    </div>

    <!-- Título -->
    <h1
      class="hero-enter mt-7 max-w-3xl font-display text-[2.7rem] leading-[1.05] font-extrabold tracking-[-0.02em] sm:text-6xl lg:text-[4.35rem]"
      style="animation-delay:60ms"
    >
      Tu marca merece una
      <span class="text-electric-gradient">
        presencia profesional
      </span>
      en la web
    </h1>

    <!-- Subtítulo -->
    <p
      class="hero-enter mt-6 max-w-xl text-lg leading-8 text-slate-300"
      style="animation-delay:120ms"
    >
      Diseñamos, publicamos y cuidamos tu sitio para que tu negocio se vea
      profesional. Solo tú pones la marca.
    </p>

    <!-- Acciones -->
    <div
      class="hero-enter mt-9 flex flex-wrap items-center gap-3.5"
      style="animation-delay:180ms"
    >
      <a href="/register" class="btn-primary group">
        Crear cuenta
        <svg
          class="size-4 transition-transform duration-300 group-hover:translate-x-1"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14" />
          <path d="m12 5 7 7-7 7" />
        </svg>
      </a>
      <a href="#pricing" class="btn-ghost-dark">Ver planes</a>
    </div>

    <!-- Stats -->
    <div
      class="hero-enter mt-16 grid max-w-2xl grid-cols-2 gap-x-6 gap-y-8 sm:grid-cols-4"
      style="animation-delay:240ms"
    >
      {
        stats.map((stat) => (
          <div class="border-l-2 border-white/15 pl-4">
            <p class="font-display text-[1.9rem] leading-tight font-bold">
              {stat.value}
            </p>
            <p class="mt-1 text-[0.68rem] font-semibold tracking-[0.14em] text-slate-400 uppercase">
              {stat.label}
            </p>
          </div>
        ))
      }
    </div>

  </div>
</section>

<style>
  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-enter {
      animation: hero-rise 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
  }
</style>
