---
const traditional = [
  "Configurar hosting y dominio",
  "Aprender a manejar un CMS",
  "Instalar y actualizar plugins",
  "Renovar certificados y respaldos",
  "Arreglar lo que se cae",
  "Pagar por cada cambio",
];

const evoruna = [
  {
    title: "Tú envías tu marca",
    desc: "Logo, textos y fotos. Ese es todo tu trabajo.",
  },
  {
    title: "Publicada y segura",
    desc: "Dominio, hosting y SSL ya incluidos.",
  },
  {
    title: "Cambios con un mensaje",
    desc: "Pides el ajuste y lo publicamos nosotros.",
  },
  {
    title: "Siempre online",
    desc: "Monitoreo y respaldos sin que lo pidas.",
  },
];
---

<section
  id="solutions"
  data-theme="dark"
  class="relative overflow-hidden bg-slate-950 text-white"
>
  <!-- Background -->
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div
      class="absolute -top-48 left-1/2 h-[34rem] w-[64rem] -translate-x-1/2 rounded-full bg-blue-600/20 blur-[130px]"
    ></div>
    <div
      class="absolute -bottom-40 -right-24 h-[30rem] w-[42rem] rounded-full bg-indigo-600/15 blur-[130px]"
    ></div>
    <div
      class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.035)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.035)_1px,transparent_1px)] bg-[size:56px_56px] [mask-image:radial-gradient(ellipse_65%_60%_at_50%_38%,black_35%,transparent_78%)] [-webkit-mask-image:radial-gradient(ellipse_65%_60%_at_50%_38%,black_35%,transparent_78%)]"
    ></div>
  </div>

  <div class="relative mx-auto max-w-6xl px-6 py-24 sm:py-28">

    <!-- Header -->
    <header class="mx-auto max-w-2xl text-center">

      <p
        class="text-xs font-bold uppercase tracking-[.18em] text-blue-400"
      >
        Lo que evitas
      </p>

      <h2
        class="mt-3 text-[clamp(2.4rem,5.5vw,3.9rem)] font-extrabold leading-[1.02] tracking-[-.045em] text-white"
      >
        Tu web,
        <span
          class="bg-gradient-to-r from-blue-400 via-sky-400 to-indigo-300 bg-clip-text text-transparent"
        >
          cero mantenimiento.
        </span>
      </h2>

      <p class="mt-5 text-base leading-7 text-slate-400 sm:text-[1.05rem]">
        Sin hosting que configurar, plugins que actualizar ni certificados que
        renovar. Tú pides el cambio; nosotros publicamos.
      </p>

    </header>


    <!-- Comparison -->
    <div class="relative mt-14">

      <div class="grid gap-5 md:grid-cols-2 md:gap-8">

        <!-- Traditional -->
        <article
          class="group relative flex flex-col overflow-hidden rounded-2xl border border-white/10 bg-white/[.02] p-7 transition-colors duration-300 hover:border-white/20 sm:p-8"
        >

          <span
            class="absolute inset-x-8 top-0 h-px bg-gradient-to-r from-transparent via-white/15 to-transparent"
            aria-hidden="true"
          ></span>

          <div class="flex items-center gap-3">
            <span
              class="flex size-9 items-center justify-center rounded-full border border-white/10 bg-white/[.04] text-slate-500"
              aria-hidden="true"
            >
              <svg
                class="size-[18px]"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M12 3l7 4v5c0 5-3.5 8-7 9-3.5-1-7-4-7-9V7l7-4z" />
              </svg>
            </span>

            <div>
              <p
                class="text-[.7rem] font-bold uppercase tracking-[.16em] text-slate-500"
              >
                El camino tradicional
              </p>
              <h3 class="text-lg font-bold tracking-tight text-slate-300">
                Lo que hoy te toca a ti
              </h3>
            </div>
          </div>

          <ul class="mt-7 flex flex-col">
            {
              traditional.map((item) => (
                <li
                  class="flex items-center gap-3 border-b border-white/[.06] py-3.5 text-slate-500 last:border-0"
                >
                  <span
                    class="flex size-5 shrink-0 items-center justify-center rounded-full bg-white/[.04] text-slate-600"
                    aria-hidden="true"
                  >
                    <svg
                      class="size-[12px]"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                    >
                      <path d="M6 6l12 12M18 6L6 18" />
                    </svg>
                  </span>
                  <span class="text-sm leading-6">{item}</span>
                </li>
              ))
            }
          </ul>

        </article>


        <!-- Evoruna -->
        <article
          class="group relative flex flex-col overflow-hidden rounded-2xl border border-blue-500/40 bg-gradient-to-b from-blue-500/[.14] via-slate-900/40 to-slate-950/20 p-7 shadow-[0_0_0_1px_rgba(37,99,235,0.18),0_35px_70px_-25px_rgba(37,99,235,0.55)] transition-[transform_box-shadow] duration-300 hover:-translate-y-1 hover:shadow-[0_0_0_1px_rgba(37,99,235,0.3),0_40px_80px_-25px_rgba(37,99,235,0.65)] sm:p-8"
        >

          <span
            class="absolute inset-x-8 top-0 h-px bg-gradient-to-r from-transparent via-blue-400/60 to-transparent"
            aria-hidden="true"
          ></span>

          <div class="flex items-center justify-between gap-3">
            <div class="flex items-center gap-3">
              <span
                class="flex size-9 items-center justify-center rounded-full bg-blue-500/20 text-blue-300"
                aria-hidden="true"
              >
                <svg
                  class="size-[18px]"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M13 3L4 14h7v7l9-11h-7V3z" />
                </svg>
              </span>

              <div>
                <p
                  class="text-[.7rem] font-bold uppercase tracking-[.16em] text-blue-400"
                >
                  Con Evoruna
                </p>
                <h3 class="text-lg font-bold tracking-tight text-white">
                  Lo que queda de nuestro lado
                </h3>
              </div>
            </div>

            <span
              class="hidden items-center gap-1.5 rounded-full border border-blue-400/30 bg-blue-500/10 px-2.5 py-1 text-[.65rem] font-semibold text-blue-200 sm:inline-flex"
            >
              <span class="size-1.5 rounded-full bg-blue-400"></span>
              Incluido
            </span>
          </div>

          <ul class="mt-7 flex flex-col">
            {
              evoruna.map((item, index) => (
                <li
                  class:list={[
                    "flex items-start gap-3.5 py-4",
                    index > 0 && "border-t border-white/[.06]",
                  ]}
                >
                  <span
                    class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-blue-500/20 text-blue-300"
                    aria-hidden="true"
                  >
                    <svg
                      class="size-[13px]"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="3"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M6 12.5l3.2 3.2L18 7.5" />
                    </svg>
                  </span>

                  <div class="min-w-0">
                    <p class="text-[.95rem] font-semibold leading-6 text-white">
                      {item.title}
                    </p>
                    <p
                      class="mt-0.5 text-sm leading-6 text-slate-400"
                    >
                      {item.desc}
                    </p>
                  </div>
                </li>
              ))
            }
          </ul>

        </article>

      </div>


      <!-- Connector -->
      <div
        class="absolute left-1/2 top-1/2 hidden -translate-x-1/2 -translate-y-1/2 md:block"
        aria-hidden="true"
      >
        <span
          class="flex size-11 items-center justify-center rounded-full border border-blue-400/40 bg-slate-950 text-[.7rem] font-bold uppercase tracking-[.1em] text-blue-300 shadow-[0_0_30px_-5px_rgba(37,99,235,0.6)]"
        >
          vs
        </span>
      </div>

    </div>


    <!-- Footnote -->
    <div
      class="mx-auto mt-12 flex max-w-xl flex-col items-center gap-1 text-center"
    >
      <p class="text-sm text-slate-500">
        Sin contratos largos. Cambias de plan cuando tu negocio lo pida.
      </p>
      <a
        href="#pricing"
        class="group mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-blue-400 transition-colors duration-200 hover:text-blue-300"
      >
        Ver planes
        <svg
          class="size-[15px] transition-transform duration-300 group-hover:translate-x-1"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14" />
          <path d="m13 6 6 6-6 6" />
        </svg>
      </a>
    </div>

  </div>
</section>
