---
const steps = [
  {
    number: "01",
    title: "Tú envías tu marca",
    description:
      "Logo, textos y fotos. Ese es todo tu trabajo. Nos cuentas cómo quieres que te vean.",
    image:
      "https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?q=80&w=900&auto=format&fit=crop",
    alt: "Documentos de planificación de marca sobre un escritorio",
  },
  {
    number: "02",
    title: "Diseñamos y publicamos",
    description:
      "Dominio, hosting y SSL ya incluidos. Tu sitio queda online, rápido y seguro en pocos días.",
    image:
      "https://images.unsplash.com/photo-1547658719-da2b51169166?q=80&w=900&auto=format&fit=crop",
    alt: "Diseño de sitio web en una laptop",
  },
  {
    number: "03",
    title: "Lo cuidamos por ti",
    description:
      "Monitoreo, respaldos y actualizaciones sin que lo pidas. Cambios con un solo mensaje.",
    image:
      "https://images.unsplash.com/photo-1551288049-bebda4e38f71?q=80&w=900&auto=format&fit=crop",
    alt: "Panel de métricas y monitoreo de un sitio web",
  },
];
---

<section
  id="solutions"
  data-theme="dark"
  class="navy-gradient relative overflow-hidden py-24 text-white sm:py-28"
>
  <!-- Brillo rojo -->
  <div
    class="pointer-events-none absolute -top-32 left-1/2 h-[26rem] w-[56rem] -translate-x-1/2 rounded-full bg-electric/8 blur-[130px]"
    aria-hidden="true"
  ></div>

  <div class="container-x relative">

    <!-- Header -->
    <header class="mx-auto mb-16 max-w-2xl text-center" data-reveal>

      <h2
        class="mt-2 font-display text-[2.3rem] leading-[1.05] font-extrabold tracking-[-0.02em] sm:text-[3.1rem]"
      >
        Tu web,
        <span class="text-electric-gradient">cero mantenimiento.</span>
      </h2>

      <p class="mt-5 text-base leading-7 text-slate-400 sm:text-[1.05rem]">
        Sin hosting que configurar, plugins que actualizar ni certificados que
        renovar. Tú pides el cambio; nosotros publicamos.
      </p>

    </header>

    <!-- Pasos -->
    <ol class="grid gap-6 md:grid-cols-3 md:gap-7">

      {
        steps.map((step, index) => (
          <li
            data-reveal
            style={`transition-delay:${index * 110}ms`}
            class="group relative flex flex-col overflow-hidden rounded-2xl border border-white/8 bg-white/[0.03] backdrop-blur-sm transition-colors duration-300 hover:border-electric/40 hover:bg-white/[0.05]"
          >

            <!-- Foto -->
            <div class="relative h-44 overflow-hidden sm:h-48">
              <img
                src={step.image}
                alt={step.alt}
                loading="lazy"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.05]"
              />
              <!-- Fundido navy hacia la tarjeta -->
              <div
                class="absolute inset-0 bg-gradient-to-t from-navy via-navy/35 to-transparent"
                aria-hidden="true"
              ></div>
              <!-- Número sobre la foto -->
              <span
                class="absolute bottom-2 left-6 font-display text-[3rem] leading-none font-extrabold tracking-[-0.03em] text-white/85 drop-shadow-[0_2px_10px_rgba(6,10,20,0.7)] transition-colors duration-300 group-hover:text-electric"
                aria-hidden="true"
              >
                {step.number}
              </span>
            </div>

            <!-- Contenido -->
            <div class="flex flex-1 flex-col p-7">

              <h3
                class="font-display text-xl font-bold tracking-[-0.015em] text-white"
              >
                {step.title}
              </h3>

              <p class="mt-3 text-[0.95rem] leading-7 text-slate-400">
                {step.description}
              </p>

            </div>

            <!-- Hairline inferior roja en hover -->
            <span
              class="absolute inset-x-8 bottom-0 h-px bg-gradient-to-r from-transparent via-electric/70 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"
              aria-hidden="true"
            ></span>

          </li>
        ))
      }

    </ol>

    <!-- Footnote -->
    <div
      class="mx-auto mt-14 flex max-w-xl flex-col items-center gap-1 text-center"
      data-reveal
    >
      <p class="text-sm text-slate-500">
        Sin contratos largos. Cambias de plan cuando tu negocio lo pida.
      </p>
      <a
        href="#pricing"
        class="group mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-electric-light transition-colors duration-200 hover:text-white"
      >
        Ver planes
        <svg
          class="size-[15px] transition-transform duration-300 group-hover:translate-x-1"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14" />
          <path d="m13 6 6 6-6 6" />
        </svg>
      </a>
    </div>

  </div>
</section>
