---
const features = [
  {
    icon: "management",
    title: "Nosotros hacemos la web",
    description:
      "Diseño, dominio, publicación y mantenimiento. Tú nos das tu marca; nosotros la dejamos online.",
  },
  {
    icon: "performance",
    title: "Rápida en cualquier pantalla",
    description:
      "Tu sitio carga fino en celular y computador para que nadie se vaya antes de contactarte.",
  },
  {
    icon: "security",
    title: "Seguridad incluida",
    description:
      "SSL, hosting y monitoreo sin que tengas que configurar servidores ni paneles.",
  },
  {
    icon: "support",
    title: "Soporte humano",
    description: "Escribes qué necesitas. Lo resolvemos nosotros, sin jerga técnica.",
  },
  {
    icon: "scale",
    title: "Actualizaciones según plan",
    description:
      "Textos, fotos o secciones nuevas, de acuerdo a lo que incluye cada plan.",
  },
  {
    icon: "infrastructure",
    title: "Siempre visible",
    description:
      "Cuidamos que tu presencia no se caiga. Tu negocio permanece encontrado.",
  },
];
---

<section
  id="features"
  class="relative overflow-hidden bg-white py-24"
>

  <!-- Brillo tenue superior -->
  <div class="pointer-events-none absolute inset-x-0 top-0 h-72" aria-hidden="true">
    <div
      class="absolute left-1/2 top-0 h-[24rem] w-[64rem] -translate-x-1/2 rounded-full bg-mist blur-[120px]"
    ></div>
  </div>

  <div class="container-x relative">

    <!-- Header -->
    <header class="mx-auto mb-14 max-w-2xl text-center" data-reveal>

      <h2
        class="mt-2 font-display text-[2.3rem] leading-[1.05] font-extrabold tracking-[-0.02em] text-navy sm:text-[3.1rem]"
      >
        Presencia web,
        <span class="text-electric-gradient">sin que tú la operes</span>
      </h2>

      <p class="mt-5 text-base leading-7 text-muted sm:text-[1.05rem]">
        Un sitio profesional, publicado y cuidado. Tú das la marca. Nosotros
        hacemos el resto.
      </p>

    </header>

    <!-- Features -->
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">

      {
        features.map((feature, index) => (
          <article
            data-reveal
            style={`transition-delay:${(index % 3) * 70}ms`}
            class="group relative flex flex-col gap-5 rounded-2xl border border-navy/8 bg-white p-7 shadow-[0_1px_2px_rgba(15,23,42,0.05)] transition-all duration-300 hover:-translate-y-1 hover:border-electric/30 hover:shadow-[0_18px_44px_-18px_rgba(235,20,20,0.28)]"
          >

            <!-- Hairline roja en hover -->
            <span
              class="absolute inset-x-6 top-0 h-px bg-gradient-to-r from-transparent via-electric/60 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"
              aria-hidden="true"
            ></span>

            <!-- Índice -->
            <span
              class="absolute right-7 top-6 text-xs font-semibold tabular-nums text-navy/25 transition-colors duration-300 group-hover:text-electric/60"
              aria-hidden="true"
            >
              {String(index + 1).padStart(2, "0")}
            </span>

            <!-- Icono -->
            <div
              class="flex size-12 items-center justify-center rounded-xl bg-electric/8 text-electric ring-1 ring-inset ring-electric/15 transition-colors duration-300 group-hover:bg-electric group-hover:text-white"
              aria-hidden="true"
            >

              {
                feature.icon === "management" && (
                  <svg
                    class="size-[22px]"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    viewBox="0 0 24 24"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 12h10" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 17h7" />
                  </svg>
                )
              }

              {
                feature.icon === "performance" && (
                  <svg
                    class="size-[22px]"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M13 3L4 14h7v7l9-11h-7V3z"
                    />
                  </svg>
                )
              }

              {
                feature.icon === "security" && (
                  <svg
                    class="size-[22px]"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M12 3l7 4v5c0 5-3.5 8-7 9-3.5-1-7-4-7-9V7l7-4z"
                    />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9.5 12l1.8 1.8L15 10" />
                  </svg>
                )
              }

              {
                feature.icon === "support" && (
                  <svg
                    class="size-[22px]"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M18 10c0-3.314-2.686-6-6-6s-6 2.686-6 6v4a2 2 0 002 2h1v-5H6m12 0h-3v5h1a2 2 0 002-2v-4z"
                    />
                  </svg>
                )
              }

              {
                feature.icon === "scale" && (
                  <svg
                    class="size-[22px]"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    viewBox="0 0 24 24"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M9 7h8v8" />
                  </svg>
                )
              }

              {
                feature.icon === "infrastructure" && (
                  <svg
                    class="size-[22px]"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    viewBox="0 0 24 24"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 3l7 4-7 4-7-4 7-4z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 11l7 4 7-4" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7 4 7-4" />
                  </svg>
                )
              }

            </div>

            <!-- Contenido -->
            <div class="mt-auto">

              <h3
                class="font-display text-[1.1rem] font-bold tracking-[-0.015em] text-navy"
              >
                {feature.title}
              </h3>

              <p class="mt-2 text-[0.95rem] leading-6 text-muted">
                {feature.description}
              </p>

            </div>

          </article>
        ))
      }

    </div>

  </div>
</section>
