---
const navigation = [
  { name: "Inicio", href: "#home" },
  { name: "Soluciones", href: "#solutions" },
  { name: "Planes", href: "#pricing" },
  { name: "Clientes", href: "#trust" },
  { name: "Ayuda", href: "#faq" },
];

const menuItems = [
  { name: "Inicio", href: "#home" },
  { name: "Soluciones", href: "#solutions" },
  { name: "Planes", href: "#pricing" },
  { name: "Clientes", href: "#trust" },
  { name: "Ayuda", href: "#faq" },
  { name: "Iniciar sesión", href: "/login" },
];
---

<header
  id="site-header"
  data-scrolled="false"
  class="fixed inset-x-0 top-0 z-40 border-b border-transparent transition-[background-color_box-shadow] duration-300"
>
  <div class="container-x flex h-[4.75rem] items-center justify-between">

    <!-- Brand -->
    <a
      href="#home"
      class="flex items-center gap-3"
      aria-label="Evoruna — volver al inicio"
    >
      <img
        src="/logo-white.webp"
        alt="EVORUNA"
        class="h-7 w-auto"
        fetchpriority="high"
        decoding="async"
      />
    </a>

    <!-- Desktop nav -->
    <nav
      class="hidden items-center gap-1 lg:flex"
      aria-label="Navegación principal"
    >
      {
        navigation.map((item) => (
          <a
            href={item.href}
            class="rounded-lg px-3.5 py-2 text-sm font-medium text-slate-300 transition-colors duration-200 hover:bg-white/5 hover:text-white"
          >
            {item.name}
          </a>
        ))
      }
    </nav>

    <!-- Desktop actions -->
    <div class="hidden items-center gap-2.5 lg:flex">
      <a
        href="/login"
        class="rounded-[12px] px-4 py-2.5 text-sm font-semibold text-slate-200 transition-colors duration-200 hover:bg-white/5 hover:text-white"
      >
        Iniciar sesión
      </a>
      <a href="/register" class="btn-primary !px-5 !py-2.5">
        Crear cuenta
        <svg
          class="size-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14" />
          <path d="m12 5 7 7-7 7" />
        </svg>
      </a>
    </div>

    <!-- Mobile trigger -->
    <button
      type="button"
      id="mobile-menu-btn"
      class="flex size-10 cursor-pointer items-center justify-center rounded-xl border border-white/10 bg-white/5 text-slate-200 transition-colors duration-200 hover:bg-white/10 hover:text-white lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Abrir menú"
    >
      <svg
        class="size-5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M4 7h16" />
        <path d="M4 12h16" />
        <path d="M4 17h16" />
      </svg>
    </button>

  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden border-t border-white/5 bg-navy-800/95 backdrop-blur-xl lg:hidden"
  >
    <nav class="container-x flex flex-col gap-1 py-5" aria-label="Menú móvil">
      {
        menuItems.map((item) => (
          <a
            href={item.href}
            class="mobile-menu-link flex items-center justify-between rounded-xl px-4 py-3 text-[15px] font-medium text-slate-200 transition-colors duration-150 hover:bg-white/5 hover:text-white"
          >
            {item.name}
            <svg
              class="size-4 text-slate-500"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14" />
              <path d="m12 5 7 7-7 7" />
            </svg>
          </a>
        ))
      }
      <a href="/register" class="btn-primary mt-3 w-full">
        Crear cuenta
      </a>
    </nav>
  </div>
</header>

<script>
  // Header sólido al hacer scroll
  const header = document.getElementById("site-header");
  const syncHeader = () => {
    if (!header) return;
    header.dataset.scrolled = String(window.scrollY > 16);
  };
  syncHeader();
  window.addEventListener("scroll", syncHeader, { passive: true });

  // Menú móvil
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  if (btn && menu) {
    btn.addEventListener("click", () => {
      const hidden = menu.classList.toggle("hidden");
      btn.setAttribute("aria-expanded", String(!hidden));
      btn.setAttribute("aria-label", hidden ? "Abrir menú" : "Cerrar menú");
    });

    menu.querySelectorAll(".mobile-menu-link").forEach((link) => {
      link.addEventListener("click", () => {
        menu.classList.add("hidden");
        btn.setAttribute("aria-expanded", "false");
      });
    });
  }
</script>

<style>
  #site-header[data-scrolled="true"] {
    background-color: hsl(222 47% 11% / 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom-color: hsl(0 0% 100% / 0.06);
    box-shadow: 0 8px 30px -12px hsl(222 47% 11% / 0.8);
  }
</style>
