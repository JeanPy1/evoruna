---
const menu = [
  { name: "Inicio", href: "#home" },
  { name: "Soluciones", href: "#solutions" },
  { name: "Planes", href: "#pricing" },
  { name: "Ayuda", href: "#faq" },
];
---

<nav id="navbar" class="fixed inset-x-0 top-0 z-50">
  <!-- Hairline superior -->
  <span
    class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-blue-500/50 to-transparent"
    aria-hidden="true"
  ></span>

  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">

    <!-- Logo -->
    <img
      id="nav-logo"
      src="/logo-color.webp"
      alt="EVORUNA"
      class="h-7 w-auto"
      fetchpriority="high"
      decoding="async"
    />

    <!-- Desktop menu -->
    <div class="hidden items-center gap-8 md:flex">
      {
        menu.map((item) => (
          <a
            href={item.href}
            class="nav-link py-2 text-sm font-medium"
          >
            {item.name}
          </a>
        ))
      }
    </div>

    <!-- Desktop actions -->
    <div class="hidden items-center gap-3 md:flex">
      <a
        href="/login"
        class="nav-ghost inline-flex items-center justify-center rounded-full px-4 py-2.5 text-sm font-semibold transition-colors duration-200"
      >
        Entrar
      </a>
      <a
        href="/register"
        class="group inline-flex items-center gap-2 rounded-full bg-blue-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition duration-500 ease-out hover:-translate-y-px hover:bg-blue-700"
      >
        Crear cuenta
        <svg
          class="size-4 transition-transform duration-500 ease-out group-hover:translate-x-1"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 5l7 7-7 7M5 12h14" />
        </svg>
      </a>
    </div>

    <!-- Mobile toggle -->
    <button
      id="menu-toggle"
      type="button"
      class="nav-hamburger flex size-8 flex-col justify-center gap-1.5 border-0 bg-transparent p-0 md:hidden"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="h-0.5 w-full rounded-full transition-colors duration-300"></span>
      <span class="h-0.5 w-full rounded-full transition-colors duration-300"></span>
      <span class="h-0.5 w-full rounded-full transition-colors duration-300"></span>
    </button>

  </div>
</nav>

<!-- Mobile overlay -->
<div
  id="mobile-overlay"
  class="pointer-events-none fixed inset-0 z-40 bg-slate-950/40 opacity-0 transition-opacity duration-300"
></div>

<!-- Mobile menu -->
<aside
  id="mobile-menu"
  class="fixed right-0 top-0 z-[60] h-full w-56 translate-x-full border-l border-slate-200 bg-white shadow-sm transition-transform duration-300 ease-out"
  aria-hidden="true"
>
  <div class="px-6 py-6">

    <!-- Close -->
    <div class="mb-8 flex justify-end">
      <button
        id="menu-close"
        type="button"
        class="flex size-10 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-700 transition-colors duration-200 hover:bg-slate-50 hover:text-slate-950"
        aria-label="Cerrar menú"
      >
        <svg
          class="size-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M18 6 6 18" />
          <path d="m6 6 12 12" />
        </svg>
      </button>
    </div>

    <!-- Links -->
    <div class="flex flex-col">
      {
        menu.map((item) => (
          <a
            href={item.href}
            class="flex items-center border-b border-slate-100 py-3 text-[15px] font-medium text-slate-700 transition-colors duration-200 hover:text-slate-950"
          >
            {item.name}
          </a>
        ))
      }
    </div>

    <!-- Actions -->
    <div class="mt-10 flex flex-col gap-3">
      <a
        href="/register"
        class="group flex w-full items-center justify-center gap-2 rounded-full bg-blue-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition duration-500 ease-out hover:-translate-y-px hover:bg-blue-700"
      >
        Crear cuenta
        <svg
          class="size-4 transition-transform duration-500 ease-out group-hover:translate-x-1"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 5l7 7-7 7M5 12h14" />
        </svg>
      </a>
      <a
        href="/login"
        class="flex w-full items-center justify-center rounded-full px-5 py-3 text-sm font-semibold text-slate-700 transition-colors duration-200 hover:text-slate-950"
      >
        Entrar
      </a>
    </div>

  </div>
</aside>

<style>
  #navbar {
    --nav-bg: rgba(255, 255, 255, 0.72);
    --nav-border: transparent;
    --nav-shadow: none;
    --nav-link: rgb(71 85 105);
    --nav-link-hover: rgb(2 6 23);
    --nav-bar: rgb(2 6 23);
    --nav-ghost: rgb(51 65 85);
    --nav-ghost-hover: rgb(2 6 23);

    background: var(--nav-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--nav-border);
    box-shadow: var(--nav-shadow);
    transition:
      background 0.3s ease,
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  #navbar.nav-scrolled {
    --nav-border: rgba(15, 23, 42, 0.08);
    --nav-shadow: 0 8px 24px rgba(15, 23, 42, 0.05);
  }

  #navbar.nav-dark {
    --nav-bg: rgba(2, 6, 23, 0.55);
    --nav-border: transparent;
    --nav-link: rgb(203 213 225);
    --nav-link-hover: #fff;
    --nav-bar: #fff;
    --nav-ghost: rgb(226 232 240);
    --nav-ghost-hover: #fff;
  }

  #navbar.nav-dark.nav-scrolled {
    --nav-border: rgba(255, 255, 255, 0.1);
    --nav-shadow: 0 8px 28px rgba(0, 0, 0, 0.35);
  }

  .nav-link {
    color: var(--nav-link);
  }
  .nav-link:hover {
    color: var(--nav-link-hover);
  }

  .nav-hamburger span {
    background: var(--nav-bar);
  }

  .nav-ghost {
    color: var(--nav-ghost);
  }
  .nav-ghost:hover {
    color: var(--nav-ghost-hover);
  }
</style>

<script>
  const navbar = document.getElementById("navbar");
  const navLogo = document.getElementById("nav-logo");
  const toggle = document.getElementById("menu-toggle");
  const menuPanel = document.getElementById("mobile-menu");
  const overlay = document.getElementById("mobile-overlay");
  const closeButton = document.getElementById("menu-close");
  const darkSections = Array.from(document.querySelectorAll('[data-theme="dark"]'));

  const HEADER_H = 64;

  /* ¿Alguna sección oscura se encuentra bajo la franja del header? */
  const isOverDark = () =>
    darkSections.some((s) => {
      const r = s.getBoundingClientRect();
      return r.top < HEADER_H && r.bottom > 0;
    });

  /* Scroll: listener pasivo + rAF => se recalcula a lo sumo 1 vez por frame */
  let ticking = false;

  const updateNavbar = () => {
    if (!navbar) return;

    const scrolled = window.scrollY > 40;
    const dark = isOverDark();

    navbar.classList.toggle("nav-scrolled", scrolled);
    navbar.classList.toggle("nav-dark", dark);

    if (navLogo) navLogo.src = dark ? "/logo-white.webp" : "/logo-color.webp";
  };

  const onScroll = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      updateNavbar();
      ticking = false;
    });
  };

  /* Compensa el ancho del scrollbar para evitar el salto lateral al bloquear el scroll */
  const getScrollbarWidth = () =>
    window.innerWidth - document.documentElement.clientWidth;

  const openMenu = () => {
    const sbw = getScrollbarWidth();
    if (sbw > 0) document.body.style.paddingRight = `${sbw}px`;

    menuPanel?.classList.remove("translate-x-full");
    menuPanel?.classList.add("translate-x-0");

    overlay?.classList.remove("pointer-events-none", "opacity-0");
    overlay?.classList.add("pointer-events-auto", "opacity-100");

    toggle?.setAttribute("aria-expanded", "true");
    menuPanel?.setAttribute("aria-hidden", "false");

    document.body.classList.add("overflow-hidden");
  };

  const closeMenu = () => {
    document.body.style.paddingRight = "";

    menuPanel?.classList.add("translate-x-full");
    menuPanel?.classList.remove("translate-x-0");

    overlay?.classList.add("pointer-events-none", "opacity-0");
    overlay?.classList.remove("pointer-events-auto", "opacity-100");

    toggle?.setAttribute("aria-expanded", "false");
    menuPanel?.setAttribute("aria-hidden", "true");

    document.body.classList.remove("overflow-hidden");
  };

  updateNavbar();
  window.addEventListener("scroll", onScroll, { passive: true });

  toggle?.addEventListener("click", () => {
    const isOpen = menuPanel?.classList.contains("translate-x-0");

    if (isOpen) {
      closeMenu();
    } else {
      openMenu();
    }
  });

  overlay?.addEventListener("click", closeMenu);
  closeButton?.addEventListener("click", closeMenu);

  /* Delegación: un solo listener para todos los links del menú móvil */
  menuPanel?.addEventListener("click", (e: MouseEvent) => {
    if (e.target instanceof Element && e.target.closest("a")) closeMenu();
  });

  /* Cerrar al cruzar el breakpoint desktop: más eficiente que "resize" */
  const desktopMq = window.matchMedia("(min-width: 768px)");
  desktopMq.addEventListener?.("change", (e) => {
    if (e.matches) closeMenu();
  });
</script>