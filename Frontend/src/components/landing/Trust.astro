---
const testimonials = [
  {
    name: "Carlos R.",
    role: "Tienda online",
    text: "Les pasé mi marca y ellos publicaron todo. Yo no toqué nada técnico.",
    time: "Hace 2 semanas",
  },
  {
    name: "Mariana P.",
    role: "Negocio local",
    text: "Cuando quiero cambiar fotos o textos, se los pido y lo dejan listo.",
    time: "Hace poco",
  },
  {
    name: "Luis G.",
    role: "Empresa comercial",
    text: "La web se ve profesional y siempre está online. Eso era lo que necesitábamos.",
    time: "Hace 3 semanas",
  },
  {
    name: "Ana T.",
    role: "Marca personal",
    text: "No tuve que preocuparme por dominio, hosting ni actualizaciones.",
    time: "Hace 4 semanas",
  },
  {
    name: "Jorge M.",
    role: "Emprendimiento",
    text: "Se siente como tener un equipo web sin contratar a nadie interno.",
    time: "Hace 1 semana",
  },
  {
    name: "Marco F.",
    role: "Negocio local",
    text: "Envié mi info y en poco tiempo ya estaba visible para mis clientes.",
    time: "Hace 5 días",
  },
  {
    name: "Lucía V.",
    role: "Oficina administrativa",
    text: "Ellos hacen los cambios. Yo solo les digo qué actualizar.",
    time: "Hace 2 semanas",
  },
  {
    name: "Pedro S.",
    role: "Pequeña empresa",
    text: "El sitio se ve serio y carga rápido. Empezamos a recibir más consultas.",
    time: "Hace 6 días",
  },
  {
    name: "Daniel C.",
    role: "Negocio local",
    text: "La web se ve bien en el celular. Eso nos trajo más mensajes.",
    time: "Hace 3 semanas",
  },
];

const testimonialSet = [...testimonials, ...testimonials];

const avatarStyles = [
  "bg-navy/5 text-navy ring-1 ring-navy/10",
  "bg-electric/8 text-electric ring-1 ring-electric/15",
  "bg-neon/10 text-neon ring-1 ring-neon/20",
];
---

<section id="trust" class="relative overflow-hidden bg-background py-20">

  <!-- Brillo tenue -->
  <div class="pointer-events-none absolute inset-x-0 top-0 h-72" aria-hidden="true">
    <div
      class="absolute left-1/2 top-0 h-[22rem] w-[56rem] -translate-x-1/2 rounded-full bg-mist blur-[110px]"
    ></div>
  </div>

  <div class="container-x relative">

    <!-- Header -->
    <header class="mx-auto mb-16 max-w-2xl text-center" data-reveal>

      <span class="kicker kicker-light !text-electric">
        <span class="size-1.5 rounded-full bg-electric"></span>
        Clientes
      </span>

      <h2
        class="mt-6 font-display text-[2.5rem] leading-[1.05] font-extrabold tracking-[-0.02em] text-navy sm:text-[3.8rem]"
      >
        Negocios que ya
        <span class="block text-electric-gradient">están online</span>
      </h2>

      <p
        class="mt-5 text-base leading-7 text-muted sm:text-lg sm:leading-8"
      >
        Ellos se enfocan en vender. Nosotros nos encargamos de que se vean bien
        online.
      </p>
    </header>


    <!-- Performance -->
    <div
      class="relative overflow-hidden rounded-2xl border border-navy/10 bg-white shadow-[0_1px_2px_rgba(15,23,42,0.05)]"
      data-reveal
    >

      <!-- Accent -->
      <span
        class="absolute inset-x-8 top-0 h-px bg-gradient-to-r from-transparent via-electric/40 to-transparent"
        aria-hidden="true"
      ></span>

      <!-- Performance header -->
      <div
        class="flex items-center justify-between border-b border-navy/8 px-6 py-4 sm:px-8"
      >
        <span
          class="text-[0.68rem] font-bold uppercase tracking-[0.18em] text-muted"
        >
          Performance
        </span>

        <span
          class="flex items-center gap-2 text-[0.68rem] font-medium text-muted"
        >
          <span class="relative flex size-1.5">
            <span
              class="absolute inline-flex h-full w-full rounded-full bg-neon opacity-60"
            ></span>
            <span
              class="relative inline-flex size-1.5 rounded-full bg-neon"
            ></span>
          </span>
          Operativo
        </span>
      </div>


      <!-- Metrics -->
      <div class="grid sm:grid-cols-3">

        <!-- Availability -->
        <div
          class="grid min-h-[14rem] grid-rows-[auto_1fr_auto] px-6 py-7 sm:px-8 sm:py-8"
        >
          <div class="flex items-center justify-between gap-4">
            <span class="text-xs font-medium text-muted">
              Disponibilidad
            </span>

            <span class="text-[0.68rem] font-semibold text-neon">
              Estable
            </span>
          </div>

          <div class="flex flex-col justify-center">
            <div class="flex items-baseline gap-2">
              <span
                class="font-display text-[clamp(2.8rem,5vw,4rem)] leading-none font-extrabold tracking-[-0.065em] text-navy"
              >
                99.9%
              </span>

              <span class="text-xs font-medium text-muted">
                uptime
              </span>
            </div>

            <!-- Bars -->
            <div class="mt-7 flex h-8 items-end gap-1">
              <i class="h-[35%] flex-1 rounded-[2px] bg-neon/15"></i>
              <i class="h-[48%] flex-1 rounded-[2px] bg-neon/20"></i>
              <i class="h-[42%] flex-1 rounded-[2px] bg-neon/25"></i>
              <i class="h-[61%] flex-1 rounded-[2px] bg-neon/35"></i>
              <i class="h-[56%] flex-1 rounded-[2px] bg-neon/45"></i>
              <i class="h-[76%] flex-1 rounded-[2px] bg-neon/60"></i>
              <i class="h-[70%] flex-1 rounded-[2px] bg-neon/75"></i>
              <i class="h-[92%] flex-1 rounded-[2px] bg-neon"></i>
            </div>
          </div>

          <p class="text-xs text-muted">
            Servicio disponible de forma estable
          </p>
        </div>


        <!-- Managed sites -->
        <div
          class="grid min-h-[14rem] grid-rows-[auto_1fr_auto] border-t border-navy/8 px-6 py-7 sm:border-l sm:border-t-0 sm:px-8 sm:py-8"
        >
          <div class="flex items-center justify-between gap-4">
            <span class="text-xs font-medium text-muted">
              Sitios gestionados
            </span>

            <span class="text-[0.68rem] font-semibold text-electric">
              En crecimiento
            </span>
          </div>

          <div class="flex flex-col justify-center">
            <div class="flex items-baseline gap-2">
              <span
                class="font-display text-[clamp(2.8rem,5vw,4rem)] leading-none font-extrabold tracking-[-0.065em] text-navy"
              >
                1,200+
              </span>

              <span class="text-xs font-medium text-muted">
                sitios
              </span>
            </div>

            <!-- Growth -->
            <div class="relative mt-7 h-8">
              <div
                class="absolute inset-x-0 bottom-0 h-px bg-navy/5"
              ></div>

              <div
                class="absolute inset-x-0 bottom-0 flex h-full items-end gap-1"
              >
                <i class="h-[25%] flex-1 rounded-t bg-electric/15"></i>
                <i class="h-[34%] flex-1 rounded-t bg-electric/20"></i>
                <i class="h-[31%] flex-1 rounded-t bg-electric/25"></i>
                <i class="h-[48%] flex-1 rounded-t bg-electric/35"></i>
                <i class="h-[55%] flex-1 rounded-t bg-electric/45"></i>
                <i class="h-[67%] flex-1 rounded-t bg-electric/60"></i>
                <i class="h-[79%] flex-1 rounded-t bg-electric/75"></i>
                <i class="h-[94%] flex-1 rounded-t bg-electric"></i>
              </div>
            </div>
          </div>

          <p class="text-xs text-muted">
            Presencias actualmente gestionadas
          </p>
        </div>


        <!-- Response -->
        <div
          class="grid min-h-[14rem] grid-rows-[auto_1fr_auto] border-t border-navy/8 px-6 py-7 sm:border-l sm:border-t-0 sm:px-8 sm:py-8"
        >
          <div class="flex items-center justify-between gap-4">
            <span class="text-xs font-medium text-muted">
              Tiempo de respuesta
            </span>

            <span class="text-[0.68rem] font-semibold text-navy">
              Rápido
            </span>
          </div>

          <div class="flex flex-col justify-center">
            <div class="flex items-baseline gap-2">
              <span
                class="font-display text-[clamp(2.8rem,5vw,4rem)] leading-none font-extrabold tracking-[-0.065em] text-navy"
              >
                &lt; 24h
              </span>

              <span class="text-xs font-medium text-muted">
                promedio
              </span>
            </div>

            <!-- Signal -->
            <div class="mt-7 flex h-8 items-center gap-1.5">
              <i class="h-2 flex-1 rounded-full bg-navy/10"></i>
              <i class="h-2 flex-1 rounded-full bg-navy/15"></i>
              <i class="h-2 flex-1 rounded-full bg-navy/25"></i>
              <i class="h-2 flex-1 rounded-full bg-navy/30"></i>
              <i class="h-2 flex-1 rounded-full bg-navy/40"></i>
              <i class="h-2 flex-1 rounded-full bg-navy/55"></i>
              <i class="h-2 flex-1 rounded-full bg-navy/70"></i>
              <i class="h-2 flex-1 rounded-full bg-navy"></i>
            </div>
          </div>

          <p class="text-xs text-muted">
            Tiempo promedio de atención
          </p>
        </div>

      </div>
    </div>


    <!-- Testimonials -->
    <div class="mt-16" data-reveal>

      <!-- Testimonials header -->
      <div class="mb-7 flex items-end justify-between gap-6">

        <div>
          <span
            class="text-[0.68rem] font-bold uppercase tracking-[0.18em] text-muted"
          >
            Experiencias
          </span>

          <h3
            class="mt-2 font-display text-xl font-bold tracking-[-0.025em] text-navy"
          >
            Lo que dicen quienes ya están online
          </h3>
        </div>

        <span
          class="hidden items-center gap-1.5 text-xs font-medium text-muted sm:inline-flex"
        >
          Pasa el cursor para pausar
          <svg
            class="size-[13px]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M8 6v12M16 6v12" />
          </svg>
        </span>

      </div>


      <!-- Infinite carousel -->
      <div class="overflow-hidden">

        <div
          class="flex w-max gap-4 motion-safe:animate-[trust-scroll_55s_linear_infinite] hover:[animation-play-state:paused]"
        >

          {
            testimonialSet.map((testimonial, index) => {
              const avatarStyle =
                avatarStyles[index % avatarStyles.length];

              return (
                <article
                  class="flex w-[17.5rem] shrink-0 flex-col rounded-2xl border border-navy/10 bg-white p-5 shadow-[0_1px_2px_rgba(15,23,42,0.05)] transition-[border-color_shadow] duration-300 hover:border-electric/30 hover:shadow-[0_14px_30px_-18px_rgba(235,20,20,0.3)] sm:w-[19rem]"
                >

                  <!-- User -->
                  <div class="flex items-center gap-3">

                    <!-- Avatar -->
                    <div
                      class:list={["flex size-10 shrink-0 items-center justify-center rounded-full text-sm font-bold",
                        avatarStyle,
                      ]}
                      aria-hidden="true"
                    >
                      {testimonial.name.charAt(0).toUpperCase()}
                    </div>

                    <!-- Identity -->
                    <div class="min-w-0">
                      <h3
                        class="truncate text-sm font-bold tracking-[-0.015em] text-navy"
                      >
                        {testimonial.name}
                      </h3>

                      <p
                        class="mt-0.5 truncate text-xs font-medium text-muted"
                      >
                        {testimonial.role}
                      </p>
                    </div>

                  </div>


                  <!-- Testimonial -->
                  <p
                    class="mt-4 text-[0.88rem] leading-[1.65] text-slate-600"
                  >
                    {testimonial.text}
                  </p>


                  <!-- Footer -->
                  <div class="mt-4 border-t border-navy/5 pt-4">
                    <p class="text-[0.7rem] font-medium text-muted">
                      {testimonial.time}
                    </p>
                  </div>

                </article>
              );
            })
          }

        </div>

      </div>

    </div>

  </div>
</section>

<style is:global>
  /* Keyframe global: la utilidad animate-[...] referencia este nombre
     literal. motion-safe ya respeta prefers-reduced-motion. */
  @keyframes trust-scroll {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(calc(-50% - 0.5rem));
    }
  }
</style>
