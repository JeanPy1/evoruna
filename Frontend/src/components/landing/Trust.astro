---
const testimonials = [
  {
    name: "Carlos R.",
    role: "Tienda online",
    text: "Les pasé mi marca y ellos publicaron todo. Yo no toqué nada técnico.",
    time: "Hace 2 semanas",
  },
  {
    name: "Mariana P.",
    role: "Negocio local",
    text: "Cuando quiero cambiar fotos o textos, se los pido y lo dejan listo.",
    time: "Hace poco",
  },
  {
    name: "Luis G.",
    role: "Empresa comercial",
    text: "La web se ve profesional y siempre está online. Eso era lo que necesitábamos.",
    time: "Hace 3 semanas",
  },
  {
    name: "Ana T.",
    role: "Marca personal",
    text: "No tuve que preocuparme por dominio, hosting ni actualizaciones.",
    time: "Hace 4 semanas",
  },
  {
    name: "Jorge M.",
    role: "Emprendimiento",
    text: "Se siente como tener un equipo web sin contratar a nadie interno.",
    time: "Hace 1 semana",
  },
  {
    name: "Marco F.",
    role: "Negocio local",
    text: "Envié mi info y en poco tiempo ya estaba visible para mis clientes.",
    time: "Hace 5 días",
  },
  {
    name: "Lucía V.",
    role: "Oficina administrativa",
    text: "Ellos hacen los cambios. Yo solo les digo qué actualizar.",
    time: "Hace 2 semanas",
  },
  {
    name: "Pedro S.",
    role: "Pequeña empresa",
    text: "El sitio se ve serio y carga rápido. Empezamos a recibir más consultas.",
    time: "Hace 6 días",
  },
  {
    name: "Daniel C.",
    role: "Negocio local",
    text: "La web se ve bien en el celular. Eso nos trajo más mensajes.",
    time: "Hace 3 semanas",
  },
];

const testimonialSet = [...testimonials, ...testimonials];

const avatarStyles = [
  "bg-indigo-50 text-indigo-600 ring-1 ring-indigo-100",
  "bg-blue-50 text-blue-600 ring-1 ring-blue-100",
  "bg-teal-50 text-teal-600 ring-1 ring-teal-100",
];
---

<section id="trust" class="relative overflow-hidden bg-slate-50">

  <!-- Background -->
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div
      class="absolute -top-44 left-1/2 h-[26rem] w-[58rem] -translate-x-1/2 rounded-full bg-blue-100/70 blur-[120px]"
    ></div>
    <div
      class="absolute inset-0 bg-[linear-gradient(to_right,rgba(15,23,42,0.04)_1px,transparent_1px),linear-gradient(to_bottom,rgba(15,23,42,0.04)_1px,transparent_1px)] bg-[size:56px_56px] [mask-image:radial-gradient(ellipse_60%_45%_at_50%_0%,black_25%,transparent_70%)] [-webkit-mask-image:radial-gradient(ellipse_60%_45%_at_50%_0%,black_25%,transparent_70%)]"
    ></div>
  </div>

  <div class="relative mx-auto max-w-6xl px-6 py-20">

    <!-- Header -->
    <header class="mx-auto mb-16 max-w-2xl text-center">

      <span
        class="inline-flex items-center gap-2 rounded-full border border-blue-100 bg-white px-3.5 py-1.5 text-[.7rem] font-bold uppercase tracking-[.14em] text-blue-700 shadow-[0_1px_2px_rgba(15,23,42,0.05)]"
      >
        <span class="size-1.5 rounded-full bg-blue-500"></span>
        Clientes
      </span>

      <h2
        class="mt-5 text-[clamp(2.5rem,5vw,4.5rem)] font-extrabold leading-[1.05] tracking-[-.05em] text-slate-950"
      >
        Negocios que ya
        <span
          class="block bg-gradient-to-r from-blue-600 via-blue-500 to-indigo-500 bg-clip-text text-transparent"
        >
          están online
        </span>
      </h2>

      <p
        class="mt-5 text-base leading-7 text-slate-600 sm:text-lg sm:leading-8"
      >
        Ellos se enfocan en vender. Nosotros nos encargamos de que se vean bien
        online.
      </p>
    </header>


    <!-- Performance -->
    <div
      class="relative overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-[0_1px_2px_rgba(15,23,42,0.04)]"
    >

      <!-- Accent -->
      <span
        class="absolute inset-x-8 top-0 h-px bg-gradient-to-r from-transparent via-blue-300/60 to-transparent"
        aria-hidden="true"
      ></span>

      <!-- Performance header -->
      <div
        class="flex items-center justify-between border-b border-slate-200 px-6 py-4 sm:px-8"
      >
        <span
          class="text-[.68rem] font-bold uppercase tracking-[.18em] text-slate-400"
        >
          Performance
        </span>

        <span
          class="flex items-center gap-2 text-[.68rem] font-medium text-slate-400"
        >
          <span class="relative flex size-1.5">
            <span
              class="absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-60"
            ></span>
            <span
              class="relative inline-flex size-1.5 rounded-full bg-emerald-500"
            ></span>
          </span>
          Operativo
        </span>
      </div>


      <!-- Metrics -->
      <div class="grid sm:grid-cols-3">

        <!-- Availability -->
        <div
          class="grid min-h-[14rem] grid-rows-[auto_1fr_auto] px-6 py-7 sm:px-8 sm:py-8"
        >
          <div class="flex items-center justify-between gap-4">
            <span class="text-xs font-medium text-slate-500">
              Disponibilidad
            </span>

            <span class="text-[.68rem] font-semibold text-emerald-600">
              Estable
            </span>
          </div>

          <div class="flex flex-col justify-center">
            <div class="flex items-baseline gap-2">
              <span
                class="text-[clamp(2.8rem,5vw,4rem)] font-extrabold leading-none tracking-[-.065em] text-slate-950"
              >
                99.9%
              </span>

              <span class="text-xs font-medium text-slate-400">
                uptime
              </span>
            </div>

            <!-- Bars -->
            <div class="mt-7 flex h-8 items-end gap-1">
              <i class="h-[35%] flex-1 rounded-[2px] bg-emerald-100"></i>
              <i class="h-[48%] flex-1 rounded-[2px] bg-emerald-100"></i>
              <i class="h-[42%] flex-1 rounded-[2px] bg-emerald-200"></i>
              <i class="h-[61%] flex-1 rounded-[2px] bg-emerald-200"></i>
              <i class="h-[56%] flex-1 rounded-[2px] bg-emerald-300"></i>
              <i class="h-[76%] flex-1 rounded-[2px] bg-emerald-300"></i>
              <i class="h-[70%] flex-1 rounded-[2px] bg-emerald-400"></i>
              <i class="h-[92%] flex-1 rounded-[2px] bg-emerald-500"></i>
            </div>
          </div>

          <p class="text-xs text-slate-400">
            Servicio disponible de forma estable
          </p>
        </div>


        <!-- Managed sites -->
        <div
          class="grid min-h-[14rem] grid-rows-[auto_1fr_auto] border-t border-slate-200 px-6 py-7 sm:border-l sm:border-t-0 sm:px-8 sm:py-8"
        >
          <div class="flex items-center justify-between gap-4">
            <span class="text-xs font-medium text-slate-500">
              Sitios gestionados
            </span>

            <span class="text-[.68rem] font-semibold text-blue-600">
              En crecimiento
            </span>
          </div>

          <div class="flex flex-col justify-center">
            <div class="flex items-baseline gap-2">
              <span
                class="text-[clamp(2.8rem,5vw,4rem)] font-extrabold leading-none tracking-[-.065em] text-slate-950"
              >
                1,200+
              </span>

              <span class="text-xs font-medium text-slate-400">
                sitios
              </span>
            </div>

            <!-- Growth -->
            <div class="relative mt-7 h-8">
              <div
                class="absolute inset-x-0 bottom-0 h-px bg-slate-100"
              ></div>

              <div
                class="absolute inset-x-0 bottom-0 flex h-full items-end gap-1"
              >
                <i class="h-[25%] flex-1 rounded-t bg-blue-100"></i>
                <i class="h-[34%] flex-1 rounded-t bg-blue-100"></i>
                <i class="h-[31%] flex-1 rounded-t bg-blue-200"></i>
                <i class="h-[48%] flex-1 rounded-t bg-blue-200"></i>
                <i class="h-[55%] flex-1 rounded-t bg-blue-300"></i>
                <i class="h-[67%] flex-1 rounded-t bg-blue-300"></i>
                <i class="h-[79%] flex-1 rounded-t bg-blue-400"></i>
                <i class="h-[94%] flex-1 rounded-t bg-blue-500"></i>
              </div>
            </div>
          </div>

          <p class="text-xs text-slate-400">
            Presencias actualmente gestionadas
          </p>
        </div>


        <!-- Response -->
        <div
          class="grid min-h-[14rem] grid-rows-[auto_1fr_auto] border-t border-slate-200 px-6 py-7 sm:border-l sm:border-t-0 sm:px-8 sm:py-8"
        >
          <div class="flex items-center justify-between gap-4">
            <span class="text-xs font-medium text-slate-500">
              Tiempo de respuesta
            </span>

            <span class="text-[.68rem] font-semibold text-teal-600">
              Rápido
            </span>
          </div>

          <div class="flex flex-col justify-center">
            <div class="flex items-baseline gap-2">
              <span
                class="text-[clamp(2.8rem,5vw,4rem)] font-extrabold leading-none tracking-[-.065em] text-slate-950"
              >
                &lt; 24h
              </span>

              <span class="text-xs font-medium text-slate-400">
                promedio
              </span>
            </div>

            <!-- Signal -->
            <div class="mt-7 flex h-8 items-center gap-1.5">
              <i class="h-2 flex-1 rounded-full bg-teal-100"></i>
              <i class="h-2 flex-1 rounded-full bg-teal-100"></i>
              <i class="h-2 flex-1 rounded-full bg-teal-200"></i>
              <i class="h-2 flex-1 rounded-full bg-teal-200"></i>
              <i class="h-2 flex-1 rounded-full bg-teal-300"></i>
              <i class="h-2 flex-1 rounded-full bg-teal-300"></i>
              <i class="h-2 flex-1 rounded-full bg-teal-400"></i>
              <i class="h-2 flex-1 rounded-full bg-teal-500"></i>
            </div>
          </div>

          <p class="text-xs text-slate-400">
            Tiempo promedio de atención
          </p>
        </div>

      </div>
    </div>


    <!-- Testimonials -->
    <div class="mt-16">

      <!-- Testimonials header -->
      <div class="mb-7 flex items-end justify-between gap-6">

        <div>
          <span
            class="text-[.68rem] font-bold uppercase tracking-[.18em] text-slate-400"
          >
            Experiencias
          </span>

          <h3
            class="mt-2 text-xl font-bold tracking-[-.025em] text-slate-950"
          >
            Lo que dicen quienes ya están online
          </h3>
        </div>

        <span
          class="hidden items-center gap-1.5 text-xs font-medium text-slate-400 sm:inline-flex"
        >
          Pasa el cursor para pausar
          <svg
            class="size-[13px]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M8 6v12M16 6v12" />
          </svg>
        </span>

      </div>


      <!-- Infinite carousel -->
      <div class="overflow-hidden">

        <div
          class="flex w-max gap-4 motion-safe:animate-[trust-scroll_55s_linear_infinite] hover:[animation-play-state:paused]"
        >

          {
            testimonialSet.map((testimonial, index) => {
              const avatarStyle =
                avatarStyles[index % avatarStyles.length];

              return (
                <article
                  class="flex w-[17.5rem] shrink-0 flex-col rounded-2xl border border-slate-200 bg-white p-5 shadow-[0_1px_2px_rgba(15,23,42,0.04)] transition-[border-color_shadow] duration-300 hover:border-blue-200 hover:shadow-[0_14px_30px_-18px_rgba(37,99,235,0.3)] sm:w-[19rem]"
                >

                  <!-- User -->
                  <div class="flex items-center gap-3">

                    <!-- Avatar -->
                    <div
                      class:list={[
                        "flex size-10 shrink-0 items-center justify-center rounded-full text-sm font-bold",
                        avatarStyle,
                      ]}
                      aria-hidden="true"
                    >
                      {testimonial.name.charAt(0).toUpperCase()}
                    </div>

                    <!-- Identity -->
                    <div class="min-w-0">
                      <h3
                        class="truncate text-sm font-bold tracking-[-.015em] text-slate-950"
                      >
                        {testimonial.name}
                      </h3>

                      <p
                        class="mt-0.5 truncate text-xs font-medium text-slate-400"
                      >
                        {testimonial.role}
                      </p>
                    </div>

                  </div>


                  <!-- Testimonial -->
                  <p
                    class="mt-4 text-[.88rem] leading-[1.65] text-slate-600"
                  >
                    {testimonial.text}
                  </p>


                  <!-- Footer -->
                  <div class="mt-4 border-t border-slate-100 pt-4">
                    <p class="text-[.7rem] font-medium text-slate-400">
                      {testimonial.time}
                    </p>
                  </div>

                </article>
              );
            })
          }

        </div>

      </div>

    </div>

  </div>
</section>

<style>
  @keyframes trust-scroll {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(calc(-50% - 0.5rem));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .motion-safe\:animate-\[trust-scroll_55s_linear_infinite\] {
      animation: none;
    }
  }
</style>
