---
const testimonials = [
  {
    name: "Carlos R.",
    role: "Tienda online",
    text: "Les pasé mi marca y ellos publicaron todo. Yo no toqué nada técnico.",
    time: "Hace 2 semanas",
  },
  {
    name: "Mariana P.",
    role: "Negocio local",
    text: "Cuando quiero cambiar fotos o textos, se los pido y lo dejan listo.",
    time: "Hace poco",
  },
  {
    name: "Luis G.",
    role: "Empresa comercial",
    text: "La web se ve profesional y siempre está online. Eso era lo que necesitábamos.",
    time: "Hace 3 semanas",
  },
  {
    name: "Ana T.",
    role: "Marca personal",
    text: "No tuve que preocuparme por dominio, hosting ni actualizaciones.",
    time: "Hace 4 semanas",
  },
  {
    name: "Jorge M.",
    role: "Emprendimiento",
    text: "Se siente como tener un equipo web sin contratar a nadie interno.",
    time: "Hace 1 semana",
  },
  {
    name: "Marco F.",
    role: "Negocio local",
    text: "Envié mi info y en poco tiempo ya estaba visible para mis clientes.",
    time: "Hace 5 días",
  },
  {
    name: "Lucía V.",
    role: "Oficina administrativa",
    text: "Ellos hacen los cambios. Yo solo les digo qué actualizar.",
    time: "Hace 2 semanas",
  },
  {
    name: "Pedro S.",
    role: "Pequeña empresa",
    text: "El sitio se ve serio y carga rápido. Empezamos a recibir más consultas.",
    time: "Hace 6 días",
  },
  {
    name: "Daniel C.",
    role: "Negocio local",
    text: "La web se ve bien en el celular. Eso nos trajo más mensajes.",
    time: "Hace 3 semanas",
  },
];

const testimonialSet = [...testimonials, ...testimonials];

const avatarStyles = [
  "bg-white/10 text-white ring-1 ring-white/25",
  "bg-electric/20 text-white ring-1 ring-white/25",
  "bg-neon/20 text-white ring-1 ring-white/25",
];

/* Mosaico de fondos: negocios reales que confían en la presencia web */
const servicePhotos = [
  {
    src:
      "https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?w=800&q=70",
    alt: "Restaurante",
  },
  {
    src:
      "https://images.unsplash.com/photo-1583337130417-3346a1be7dee?w=800&q=70",
    alt: "Veterinaria",
  },
  {
    src:
      "https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?w=800&q=70",
    alt: "Clínica",
  },
  {
    src:
      "https://images.unsplash.com/photo-1441986300917-64674bd600d8?w=800&q=70",
    alt: "Tienda de ropa",
  },
  {
    src:
      "https://images.unsplash.com/photo-1509440159596-0249088772ff?w=800&q=70",
    alt: "Panadería",
  },
  {
    src:
      "https://images.unsplash.com/photo-1487530811176-3780de880c2d?w=800&q=70",
    alt: "Floristería",
  },
];
---

<section
  id="trust"
  data-theme="dark"
  class="relative overflow-hidden bg-navy py-16 text-white"
>

  <!-- Mosaico de negocios + velo navy (estilo hero) -->
  <div class="absolute inset-0" aria-hidden="true">
    <div class="grid h-full grid-cols-2 gap-2 opacity-40 md:grid-cols-3">
      {servicePhotos.map((photo) => (
        <img
          src={photo.src}
          alt={photo.alt}
          loading="lazy"
          class="h-full w-full object-cover"
        />
      ))}
    </div>
    <div
      class="absolute inset-0 bg-gradient-to-b from-navy via-navy/60 to-navy"
    ></div>
    <div class="absolute inset-0 bg-navy/30"></div>
  </div>

  <div class="container-x relative">

    <!-- Header -->
    <header class="mx-auto mb-16 max-w-2xl text-center" data-reveal>
      <h2
        class="mt-2 font-display text-[2.5rem] leading-[1.05] font-extrabold tracking-[-0.02em] text-white sm:text-[3.8rem]"
      >
        Negocios que ya
        <span class="block text-electric-gradient">están online</span>
      </h2>

      <p class="mt-5 text-base leading-7 text-slate-300 sm:text-lg sm:leading-8">
        Ellos se enfocan en vender. Nosotros nos encargamos de que se vean bien
        online.
      </p>
    </header>


    <!-- Performance -->
    <div
      class="relative overflow-hidden rounded-2xl border border-white/10 bg-white/8 shadow-[0_18px_40px_-24px_rgba(2,6,17,0.7)] backdrop-blur-md"
      data-reveal
    >

      <!-- Accent -->
      <span
        class="absolute inset-x-8 top-0 h-px bg-gradient-to-r from-transparent via-electric/40 to-transparent"
        aria-hidden="true"
      ></span>

      <!-- Performance header -->
      <div
        class="flex items-center justify-between border-b border-white/10 px-6 py-4 sm:px-8"
      >
        <span
          class="text-[0.68rem] font-bold uppercase tracking-[0.18em] text-slate-400"
        >
          Performance
        </span>

        <span
          class="flex items-center gap-2 text-[0.68rem] font-medium text-slate-400"
        >
          <span class="relative flex size-1.5">
            <span
              class="absolute inline-flex h-full w-full rounded-full bg-neon opacity-60"
            ></span>
            <span
              class="relative inline-flex size-1.5 rounded-full bg-neon"
            ></span>
          </span>
          Operativo
        </span>
      </div>


      <!-- Metrics -->
      <div class="grid sm:grid-cols-3">

        <!-- Availability -->
        <div
          class="grid min-h-[14rem] grid-rows-[auto_1fr_auto] px-6 py-7 sm:px-8 sm:py-8"
        >
          <div class="flex items-center justify-between gap-4">
            <span class="text-xs font-medium text-slate-400">
              Disponibilidad
            </span>

            <span class="text-[0.68rem] font-semibold text-neon">
              Estable
            </span>
          </div>

          <div class="flex flex-col justify-center">
            <div class="flex items-baseline gap-2">
              <span
                class="font-display text-[clamp(2.8rem,5vw,4rem)] leading-none font-extrabold tracking-[-0.065em] text-white"
              >
                99.9%
              </span>

              <span class="text-xs font-medium text-slate-400">
                uptime
              </span>
            </div>

            <!-- Bars -->
            <div class="mt-7 flex h-8 items-end gap-1">
              <i class="h-[35%] flex-1 rounded-[2px] bg-neon/15"></i>
              <i class="h-[48%] flex-1 rounded-[2px] bg-neon/20"></i>
              <i class="h-[42%] flex-1 rounded-[2px] bg-neon/25"></i>
              <i class="h-[61%] flex-1 rounded-[2px] bg-neon/35"></i>
              <i class="h-[56%] flex-1 rounded-[2px] bg-neon/45"></i>
              <i class="h-[76%] flex-1 rounded-[2px] bg-neon/60"></i>
              <i class="h-[70%] flex-1 rounded-[2px] bg-neon/75"></i>
              <i class="h-[92%] flex-1 rounded-[2px] bg-neon"></i>
            </div>
          </div>

          <p class="text-xs text-slate-400">
            Servicio disponible de forma estable
          </p>
        </div>


        <!-- Managed sites -->
        <div
          class="grid min-h-[14rem] grid-rows-[auto_1fr_auto] border-t border-white/10 px-6 py-7 sm:border-l sm:border-t-0 sm:px-8 sm:py-8"
        >
          <div class="flex items-center justify-between gap-4">
            <span class="text-xs font-medium text-slate-400">
              Sitios gestionados
            </span>

            <span class="text-[0.68rem] font-semibold text-electric">
              En crecimiento
            </span>
          </div>

          <div class="flex flex-col justify-center">
            <div class="flex items-baseline gap-2">
              <span
                class="font-display text-[clamp(2.8rem,5vw,4rem)] leading-none font-extrabold tracking-[-0.065em] text-white"
              >
                1,200+
              </span>

              <span class="text-xs font-medium text-slate-400">
                sitios
              </span>
            </div>

            <!-- Growth -->
            <div class="relative mt-7 h-8">
              <div
                class="absolute inset-x-0 bottom-0 h-px bg-white/10"
              ></div>

              <div
                class="absolute inset-x-0 bottom-0 flex h-full items-end gap-1"
              >
                <i class="h-[25%] flex-1 rounded-t bg-electric/15"></i>
                <i class="h-[34%] flex-1 rounded-t bg-electric/20"></i>
                <i class="h-[31%] flex-1 rounded-t bg-electric/25"></i>
                <i class="h-[48%] flex-1 rounded-t bg-electric/35"></i>
                <i class="h-[55%] flex-1 rounded-t bg-electric/45"></i>
                <i class="h-[67%] flex-1 rounded-t bg-electric/60"></i>
                <i class="h-[79%] flex-1 rounded-t bg-electric/75"></i>
                <i class="h-[94%] flex-1 rounded-t bg-electric"></i>
              </div>
            </div>
          </div>

          <p class="text-xs text-slate-400">
            Presencias actualmente gestionadas
          </p>
        </div>


        <!-- Response -->
        <div
          class="grid min-h-[14rem] grid-rows-[auto_1fr_auto] border-t border-white/10 px-6 py-7 sm:border-l sm:border-t-0 sm:px-8 sm:py-8"
        >
          <div class="flex items-center justify-between gap-4">
            <span class="text-xs font-medium text-slate-400">
              Tiempo de respuesta
            </span>

            <span class="text-[0.68rem] font-semibold text-white">
              Rápido
            </span>
          </div>

          <div class="flex flex-col justify-center">
            <div class="flex items-baseline gap-2">
              <span
                class="font-display text-[clamp(2.8rem,5vw,4rem)] leading-none font-extrabold tracking-[-0.065em] text-white"
              >
                &lt; 24h
              </span>

              <span class="text-xs font-medium text-slate-400">
                promedio
              </span>
            </div>

            <!-- Signal -->
            <div class="mt-7 flex h-8 items-center gap-1.5">
              <i class="h-2 flex-1 rounded-full bg-white/10"></i>
              <i class="h-2 flex-1 rounded-full bg-white/15"></i>
              <i class="h-2 flex-1 rounded-full bg-white/25"></i>
              <i class="h-2 flex-1 rounded-full bg-white/30"></i>
              <i class="h-2 flex-1 rounded-full bg-white/40"></i>
              <i class="h-2 flex-1 rounded-full bg-white/55"></i>
              <i class="h-2 flex-1 rounded-full bg-white/70"></i>
              <i class="h-2 flex-1 rounded-full bg-white"></i>
            </div>
          </div>

          <p class="text-xs text-slate-400">
            Tiempo promedio de atención
          </p>
        </div>

      </div>
    </div>


    <!-- Testimonials -->
    <div class="mt-16" data-reveal>

      <!-- Testimonials header -->
      <div class="mb-7 flex items-end justify-between gap-6">

        <div>
          <span
            class="text-[0.68rem] font-bold uppercase tracking-[0.18em] text-slate-400"
          >
            Experiencias
          </span>

          <h3
            class="mt-2 font-display text-xl font-bold tracking-[-0.025em] text-white"
          >
            Lo que dicen quienes ya están online
          </h3>
        </div>

        <span
          class="hidden items-center gap-1.5 text-xs font-medium text-slate-400 sm:inline-flex"
        >
          Pasa el cursor para pausar
          <svg
            class="size-[13px]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M8 6v12M16 6v12" />
          </svg>
        </span>

      </div>


      <!-- Infinite carousel: el -my/py compensa para que el recorte
           no corte el card elevado ni su sombra al hover -->
      <div class="-my-10 overflow-hidden py-10">

        <div
          class="flex w-max gap-4 motion-safe:animate-[trust-scroll_55s_linear_infinite] hover:[animation-play-state:paused]"
        >

          {
            testimonialSet.map((testimonial, index) => {
              const avatarStyle =
                avatarStyles[index % avatarStyles.length];
              const rating = index % 4 === 2 ? "4.8" : "5.0";

              return (
                <article
                  class="group relative flex w-[20.5rem] shrink-0 flex-col overflow-hidden rounded-2xl border border-white/10 bg-white/8 p-6 shadow-[0_18px_40px_-24px_rgba(2,6,17,0.6)] backdrop-blur-md transition-all duration-300 hover:-translate-y-1 hover:border-electric/40 hover:bg-white/12 hover:shadow-[0_22px_44px_-20px_rgba(235,20,20,0.45)] sm:w-[21.5rem]"
                >

                  <!-- Acento superior al hover -->
                  <span
                    class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-electric/70 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"
                    aria-hidden="true"
                  ></span>

                  <!-- Header: avatar + identidad + rating -->
                  <div class="flex items-center gap-3">

                    <!-- Avatar -->
                    <div
                      class:list={["flex size-11 shrink-0 items-center justify-center rounded-full text-base font-bold",
                        avatarStyle,
                      ]}
                      aria-hidden="true"
                    >
                      {testimonial.name.charAt(0).toUpperCase()}
                    </div>

                    <!-- Identity -->
                    <div class="min-w-0 flex-1">
                      <div class="flex items-center gap-1.5">
                        <h3
                          class="truncate text-[0.95rem] font-bold tracking-[-0.015em] text-white"
                        >
                          {testimonial.name}
                        </h3>

                        <!-- Verificado -->
                        <svg
                          class="size-3.5 shrink-0 text-neon"
                          viewBox="0 0 24 24"
                          fill="currentColor"
                          aria-hidden="true"
                        >
                          <path
                            d="M12 1.5l2.6 2.2 3.4-.6.6 3.4 3.1 1.9-1.6 3.1 1.6 3.1-3.1 1.9-.6 3.4-3.4-.6-2.6 2.2-2.6-2.2-3.4.6-.6-3.4-3.1-1.9 1.6-3.1-1.6-3.1 3.1-1.9.6-3.4 3.4.6L12 1.5z"
                          />
                          <path
                            d="M10.6 15.2l-2.9-2.9 1.2-1.2 1.7 1.7 4.5-4.5 1.2 1.2-5.7 5.7z"
                            fill="#fff"
                          />
                        </svg>
                      </div>

                      <p
                        class="mt-0.5 truncate text-xs font-medium text-slate-400"
                      >
                        {testimonial.role}
                      </p>
                    </div>

                    <!-- Rating -->
                    <div class="flex shrink-0 flex-col items-end">
                      <div class="flex items-center gap-0.5">
                        {[0, 1, 2, 3, 4].map((star) => (
                          <svg
                            class="size-3 text-electric"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                            aria-hidden="true"
                          >
                            <path
                              d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
                            />
                          </svg>
                        ))}
                      </div>

                      <span class="mt-1 text-[0.68rem] font-bold text-white">
                        {rating}
                      </span>
                    </div>

                  </div>


                  <!-- Testimonial -->
                  <p class="mt-4 flex-1 text-[0.9rem] leading-[1.7] text-white/85">
                    {testimonial.text}
                  </p>


                  <!-- Footer -->
                  <div class="mt-5 flex items-center justify-between border-t border-white/10 pt-4">
                    <p class="text-[0.7rem] font-medium text-slate-400">
                      {testimonial.time}
                    </p>

                    <span
                      class="rounded-full bg-white/5 px-2.5 py-1 text-[0.65rem] font-bold tracking-wide text-white/60 ring-1 ring-white/10"
                    >
                      Cliente Evoruna
                    </span>
                  </div>

                </article>
              );
            })
          }

        </div>

      </div>

    </div>

  </div>
</section>

<style is:global>
  /* Keyframe global: la utilidad animate-[...] referencia este nombre
     literal. motion-safe ya respeta prefers-reduced-motion. */
  @keyframes trust-scroll {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(calc(-50% - 0.5rem));
    }
  }
</style>
