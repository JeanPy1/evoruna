---
const faqs = [
  {
    question: "¿Qué tengo que hacer yo?",
    answer: "Envíanos logo, textos, fotos y datos de contacto. Nosotros diseñamos, publicamos y cuidamos tu sitio.",
  },
  {
    question: "¿Tengo que administrar la web?",
    answer: "No. No te dejamos un panel complicado. Si hay que cambiar algo, nos lo pides y lo hacemos nosotros.",
  },
  {
    question: "¿Qué incluye un ajuste de contenido?",
    answer: "Textos, imágenes o detalles visuales. Un cambio de estructura cubre secciones nuevas o un rediseño de bloques.",
  },
  {
    question: "¿Los ajustes dependen del plan?",
    answer: "Sí. Starter cubre la presencia base. Pro incluye 1 ajuste de contenido. Business incluye contenido y estructura.",
  },
  {
    question: "¿Cada cuánto se cobra?",
    answer: "Cobro anual único. Pagas una vez al año y nosotros nos encargamos del hosting, dominio, correo y monitoreo.",
  },
  {
    question: "¿Necesito saber de tecnología?",
    answer: "No. El servicio existe para que tú vendas y nosotros nos ocupemos de que tu marca se vea bien online.",
  },
  {
    question: "¿Puedo cambiar de plan después?",
    answer: "Sí. Puedes pasar a un plan con más actualizaciones cuando tu negocio lo pida.",
  },
];
---

<section id="faq" class="faq-section relative overflow-hidden bg-white py-16">

  <!-- Brillo tenue -->
  <div class="pointer-events-none absolute inset-x-0 top-0 h-72" aria-hidden="true">
    <div
      class="absolute left-1/2 top-0 h-[22rem] w-[52rem] -translate-x-1/2 rounded-full bg-mist blur-[110px]"
    ></div>
  </div>

  <div class="container-x relative">

    <!-- Header -->
    <header class="mx-auto mb-12 max-w-2xl text-center" data-reveal>
      <h2
        class="mt-2 font-display text-[2.3rem] leading-[1.05] font-extrabold tracking-[-0.02em] text-navy sm:text-[3.1rem]"
      >
        Preguntas frecuentes
      </h2>

      <p class="mt-5 text-base leading-7 text-muted sm:text-[1.05rem]">
        Lo esencial para entender cómo publicamos y cuidamos tu presencia.
      </p>

    </header>

    <!-- FAQ -->
    <div class="faq-list mx-auto flex max-w-3xl flex-col gap-3">

      {
        faqs.map((faq) => (
          <div
            data-reveal
            class="faq-item overflow-hidden rounded-2xl border border-navy/10 bg-white shadow-[0_1px_2px_rgba(15,23,42,0.04)] transition-[border-color,box-shadow,transform] duration-300 hover:-translate-y-px hover:border-electric/30 hover:shadow-[0_14px_34px_rgba(235,20,20,0.08)]"
          >

            <!-- Pregunta -->
            <button
              class="faq-question flex w-full cursor-pointer items-center justify-between gap-6 border-0 bg-transparent px-6 py-5 text-left font-inherit sm:px-7"
              type="button"
              aria-expanded="false"
            >
              <span
                class="font-display text-[0.95rem] leading-6 font-bold tracking-[-0.01em] text-navy sm:text-base"
              >
                {faq.question}
              </span>

              <!-- Icono -->
              <span
                class="faq-icon-wrapper flex size-8 shrink-0 items-center justify-center rounded-full bg-electric/8 text-electric ring-1 ring-inset ring-electric/15 transition-all duration-300"
                aria-hidden="true"
              >
                <svg
                  class="size-[15px]"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </button>

            <!-- Respuesta -->
            <div
              class="faq-answer grid grid-rows-[0fr] transition-[grid-template-rows] duration-350 ease-out"
            >
              <div class="min-h-0 overflow-hidden">
                <p
                  class="px-6 pb-5 text-[0.9rem] leading-7 text-muted sm:px-7 sm:pb-6 sm:text-[0.95rem]"
                >
                  {faq.answer}
                </p>
              </div>
            </div>

          </div>
        ))
      }

    </div>

  </div>
</section>

<style>
  .faq-question:focus-visible {
    outline: 2px solid rgb(235 20 20);
    outline-offset: 2px;
  }

  .faq-item.open {
    border-color: rgb(235 20 20 / 0.35);
  }

  .faq-item.open .faq-icon-wrapper {
    background: rgb(235 20 20);
    color: #fff;
    ring-color: transparent;
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item,
    .faq-answer,
    .faq-icon-wrapper {
      transition: none;
    }
  }
</style>

<script>
  const list = document.querySelector(".faq-list");

  list?.addEventListener("click", (event) => {
    const target = event.target;

    if (!(target instanceof Element)) return;

    const button = target.closest(".faq-question");

    if (!(button instanceof HTMLButtonElement)) return;

    const item = button.closest(".faq-item");

    if (!(item instanceof HTMLElement)) return;

    const wasOpen = item.classList.contains("open");

    // Cerrar el anterior
    const openItem = list.querySelector(".faq-item.open");

    if (openItem && openItem !== item) {
      openItem.classList.remove("open");

      const openButton =
        openItem.querySelector(".faq-question");

      const openAnswer =
        openItem.querySelector(".faq-answer");

      const openIcon =
        openItem.querySelector(".faq-icon-wrapper");

      openButton?.setAttribute("aria-expanded", "false");

      openAnswer?.classList.replace(
        "grid-rows-[1fr]",
        "grid-rows-[0fr]"
      );

      openIcon?.classList.remove("rotate-180");
    }

    // Toggle actual
    const isOpen = !wasOpen;

    item.classList.toggle("open", isOpen);

    button.setAttribute(
      "aria-expanded",
      String(isOpen)
    );

    const answer =
      item.querySelector(".faq-answer");

    const icon =
      item.querySelector(".faq-icon-wrapper");

    if (isOpen) {
      answer?.classList.replace(
        "grid-rows-[0fr]",
        "grid-rows-[1fr]"
      );

      icon?.classList.add("rotate-180");
    } else {
      answer?.classList.replace(
        "grid-rows-[1fr]",
        "grid-rows-[0fr]"
      );

      icon?.classList.remove("rotate-180");
    }
  });
</script>
