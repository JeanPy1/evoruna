---
const faqs = [
  {
    question: "¿Qué tengo que hacer yo?",
    answer: "Envíanos logo, textos, fotos y datos de contacto. Nosotros diseñamos, publicamos y cuidamos tu sitio.",
  },
  {
    question: "¿Tengo que administrar la web?",
    answer: "No. No te dejamos un panel complicado. Si hay que cambiar algo, nos lo pides y lo hacemos nosotros.",
  },
  {
    question: "¿Qué incluye un ajuste de contenido?",
    answer: "Textos, imágenes o detalles visuales. Un cambio de estructura cubre secciones nuevas o un rediseño de bloques.",
  },
  {
    question: "¿Los ajustes dependen del plan?",
    answer: "Sí. Starter cubre la presencia base. Pro incluye 1 ajuste de contenido. Business incluye contenido y estructura.",
  },
  {
    question: "¿Cada cuánto se cobra?",
    answer: "Cobro anual único. Pagas una vez al año y nosotros nos encargamos del hosting, dominio, correo y monitoreo.",
  },
  {
    question: "¿Necesito saber de tecnología?",
    answer: "No. El servicio existe para que tú vendas y nosotros nos ocupemos de que tu marca se vea bien online.",
  },
  {
    question: "¿Puedo cambiar de plan después?",
    answer: "Sí. Puedes pasar a un plan con más actualizaciones cuando tu negocio lo pida.",
  },
];
---

<section
  id="faq"
  class="relative overflow-hidden bg-[radial-gradient(40rem_30rem_at_0%_0%,rgba(79,70,229,0.08),transparent_60%),radial-gradient(40rem_30rem_at_100%_100%,rgba(37,99,235,0.07),transparent_60%),linear-gradient(to_bottom,#f8fafc,#ffffff)] py-20 before:pointer-events-none before:absolute before:inset-0 before:bg-[linear-gradient(to_right,#0f172a_1px,transparent_1px),linear-gradient(to_bottom,#0f172a_1px,transparent_1px)] before:bg-[size:42px_42px] before:opacity-[0.035]"
>
  <div class="relative mx-auto max-w-5xl px-6">

    <!-- Header -->
    <header class="mx-auto mb-12 max-w-2xl text-center">
      <p class="text-[.7rem] font-bold uppercase tracking-[.16em] text-blue-600">
        FAQ
      </p>

      <h2
        class="mt-2.5 text-[clamp(2.4rem,5vw,4.5rem)] font-extrabold leading-[1.02] tracking-[-.045em] text-slate-950"
      >
        Preguntas frecuentes
      </h2>

      <p
        class="mt-4 text-base leading-7 text-slate-600 sm:text-[1.05rem]"
      >
        Lo esencial para entender cómo publicamos y cuidamos tu presencia.
      </p>
    </header>

    <!-- FAQ -->
    <div class="faq-list flex flex-col gap-3">

      {
        faqs.map((faq) => (
          <div
            class="faq-item overflow-hidden rounded-[1.2rem] border border-slate-200/90 bg-white/90 shadow-[0_8px_28px_rgba(15,23,42,0.035)] transition-[border-color,box-shadow,transform] duration-250 hover:-translate-y-px hover:border-indigo-200 hover:shadow-[0_14px_34px_rgba(15,23,42,0.06)]"
          >

            <!-- Question -->
            <button
              class="faq-question flex w-full cursor-pointer items-center justify-between gap-6 border-0 bg-transparent px-5 py-5 text-left font-inherit sm:px-[1.35rem]"
              type="button"
              aria-expanded="false"
            >
              <span
                class="text-[.95rem] font-bold leading-6 tracking-[-.01em] text-slate-950 sm:text-base"
              >
                {faq.question}
              </span>

              <!-- Icon -->
              <span
                class="faq-icon-wrapper flex size-8 shrink-0 items-center justify-center rounded-full bg-blue-600/[0.07] text-blue-600 transition-all duration-300"
                aria-hidden="true"
              >
                <svg
                  class="size-[15px]"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </button>

            <!-- Answer -->
            <div
              class="faq-answer grid grid-rows-[0fr] transition-[grid-template-rows] duration-350 ease-out"
            >
              <div class="min-h-0 overflow-hidden">
                <p
                  class="px-5 pb-5 text-[.9rem] leading-7 text-slate-500 sm:px-[1.35rem] sm:pb-[1.35rem] sm:text-[.95rem]"
                >
                  {faq.answer}
                </p>
              </div>
            </div>

          </div>
        ))
      }

    </div>
  </div>
</section>

<style>
  .faq-question:focus-visible{
    outline: 2px solid rgb(37 99 235);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce){
    .faq-item,
    .faq-answer,
    .faq-icon-wrapper{
      transition: none;
    }
  }
</style>

<script>
  const list = document.querySelector(".faq-list");

  list?.addEventListener("click", (event) => {
    const target = event.target;

    if (!(target instanceof Element)) return;

    const button = target.closest(".faq-question");

    if (!(button instanceof HTMLButtonElement)) return;

    const item = button.closest(".faq-item");

    if (!(item instanceof HTMLElement)) return;

    const wasOpen = item.classList.contains("open");

    // Cerrar el anterior
    const openItem = list.querySelector(".faq-item.open");

    if (openItem && openItem !== item) {
      openItem.classList.remove("open");

      const openButton =
        openItem.querySelector(".faq-question");

      const openAnswer =
        openItem.querySelector(".faq-answer");

      const openIcon =
        openItem.querySelector(".faq-icon-wrapper");

      openButton?.setAttribute("aria-expanded", "false");

      openAnswer?.classList.replace(
        "grid-rows-[1fr]",
        "grid-rows-[0fr]"
      );

      openIcon?.classList.remove("rotate-180");
    }

    // Toggle actual
    const isOpen = !wasOpen;

    item.classList.toggle("open", isOpen);

    button.setAttribute(
      "aria-expanded",
      String(isOpen)
    );

    const answer =
      item.querySelector(".faq-answer");

    const icon =
      item.querySelector(".faq-icon-wrapper");

    if (isOpen) {
      answer?.classList.replace(
        "grid-rows-[0fr]",
        "grid-rows-[1fr]"
      );

      icon?.classList.add("rotate-180");
    } else {
      answer?.classList.replace(
        "grid-rows-[1fr]",
        "grid-rows-[0fr]"
      );

      icon?.classList.remove("rotate-180");
    }
  });
</script>