---
const navigation = [
  { name: "Inicio", href: "#home" },
  { name: "Soluciones", href: "#solutions" },
  { name: "Planes", href: "#pricing" },
  { name: "Ayuda", href: "#faq" },
];
---

<footer
  id="footer"
  data-theme="dark"
  class="relative overflow-hidden border-t border-white/[0.06] bg-[#060a14] text-white"
>

  <!-- Background -->
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div
      class="absolute -top-32 left-1/2 h-[18rem] w-[48rem] -translate-x-1/2 rounded-full bg-electric/8 blur-[110px]"
    ></div>
  </div>

  <!-- Top accent -->
  <span
    class="absolute inset-x-16 top-0 h-px bg-gradient-to-r from-transparent via-electric/30 to-transparent"
    aria-hidden="true"
  ></span>

  <div class="container-x relative pt-16 pb-8">

    <!-- Main -->
    <div
      class="grid gap-12 text-center md:grid-cols-[1.5fr_1fr_1fr] md:gap-10 md:text-left"
    >

      <!-- Brand -->
      <div class="flex flex-col items-center gap-5 md:items-start">

        <img
          src="/logo-white.webp"
          alt="EVORUNA"
          class="h-7 w-auto"
          loading="lazy"
        />

        <p class="max-w-sm text-sm leading-7 text-slate-400">
          Presencia web gestionada: diseñamos, publicamos y cuidamos tu sitio
          para que tu marca se vea profesional.
        </p>

        <!-- Social -->
        <div
          class="flex items-center gap-3"
          aria-label="Redes y contacto directo"
        >

          <a
            href="https://wa.me/51910376251?text=Hola,%20quiero%20mas%20informacion"
            aria-label="WhatsApp"
            class="flex size-10 items-center justify-center rounded-full border border-white/10 bg-white/[0.03] text-slate-400 transition-[border-color_background-color_color] duration-200 hover:border-electric/50 hover:bg-electric/10 hover:text-electric-light"
          >
            <svg
              class="size-[18px]"
              fill="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                d="M20.52 3.48A11.82 11.82 0 0012.05 0C5.5 0 .18 5.32.18 11.88c0 2.1.55 4.15 1.6 5.96L0 24l6.34-1.66a11.86 11.86 0 005.71 1.46h.01c6.55 0 11.87-5.32 11.87-11.88 0-3.17-1.24-6.15-3.41-8.44zM12.06 21.8a9.9 9.9 0 01-5.05-1.38l-.36-.21-3.76.99 1-3.66-.24-.38a9.86 9.86 0 01-1.51-5.28c0-5.48 4.45-9.94 9.92-9.94 2.65 0 5.14 1.04 7.01 2.93a9.86 9.86 0 012.9 7c0 5.48-4.45 9.93-9.91 9.93zm5.44-7.42c-.3-.15-1.77-.88-2.04-.98-.27-.1-.47-.15-.67.15s-.77.98-.95 1.18c-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.47-.89-.8-1.5-1.77-1.67-2.07-.18-.3-.02-.46.13-.6.13-.13.3-.35.45-.53.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.5h-.57c-.2 0-.52.08-.8.37-.27.3-1.05 1.03-1.05 2.5s1.08 2.9 1.23 3.1c.15.2 2.12 3.24 5.13 4.54.72.31 1.28.5 1.72.64.72.23 1.38.2 1.9.12.58-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.12-.27-.2-.57-.35z"
              />
            </svg>
          </a>

          <a
            href="https://www.facebook.com/people/Evoruna/61593789937210/"
            aria-label="Facebook"
            class="flex size-10 items-center justify-center rounded-full border border-white/10 bg-white/[0.03] text-slate-400 transition-[border-color_background-color_color] duration-200 hover:border-electric/50 hover:bg-electric/10 hover:text-electric-light"
          >
            <svg
              class="size-[18px]"
              fill="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07c0 6.03 4.39 11.02 10.13 11.93v-8.44H7.08v-3.5h3.05V9.41c0-3.03 1.79-4.7 4.53-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.5 0-1.96.93-1.96 1.88v2.26h3.34l-.53 3.5h-2.81V24C19.61 23.1 24 18.1 24 12.07z"
              />
            </svg>
          </a>

          <a
            href="mailto:soporte@evoruna.com"
            aria-label="Email"
            class="flex size-10 items-center justify-center rounded-full border border-white/10 bg-white/[0.03] text-slate-400 transition-[border-color_background-color_color] duration-200 hover:border-electric/50 hover:bg-electric/10 hover:text-electric-light"
          >
            <svg
              class="size-[18px]"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16v12H4z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 7l8 6 8-6" />
            </svg>
          </a>

        </div>
      </div>


      <!-- Navigation -->
      <nav
        class="flex flex-col items-center gap-5 md:items-start"
        aria-label="Navegación"
      >
        <span
          class="text-[0.68rem] font-bold tracking-[0.18em] uppercase text-slate-500"
        >
          Navegación
        </span>

        <ul class="flex flex-col gap-2.5">
          {
            navigation.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-sm font-medium text-slate-400 transition-colors duration-200 hover:text-white"
                >
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>


      <!-- Contact -->
      <div class="flex flex-col items-center gap-5 md:items-start">
        <span
          class="text-[0.68rem] font-bold tracking-[0.18em] uppercase text-slate-500"
        >
          Contacto
        </span>

        <ul class="flex flex-col gap-2.5">
          <li>
            <a
              href="mailto:informes@evoruna.com"
              class="inline-flex items-center gap-2 text-sm font-medium text-slate-400 transition-colors duration-200 hover:text-white"
            >
              <svg
                class="size-4"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M4 6h16v12H4z"
                />
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M4 7l8 6 8-6"
                />
              </svg>
              informes@evoruna.com
            </a>
          </li>

          <li>
            <a
              href="/register"
              class="text-sm font-semibold text-electric-light transition-colors duration-200 hover:text-white"
            >
              Empezar ahora
            </a>
          </li>
        </ul>
      </div>

    </div>


    <!-- Bottom -->
    <div
      class="mt-14 flex flex-col items-center justify-center gap-x-6 gap-y-2 border-t border-white/[0.06] pt-6 text-center text-xs text-slate-600 sm:flex-row"
    >
      <span>
        © {new Date().getFullYear()} Evoruna
      </span>

      <span class="hidden size-1 rounded-full bg-slate-700 sm:block"></span>

      <span>
        Diseñado para marcas modernas
      </span>

      <a
        href="#home"
        class="group inline-flex items-center gap-1.5 transition-colors duration-200 hover:text-slate-400 sm:ml-auto"
      >
        Volver arriba
        <svg
          class="size-[13px] transition-transform duration-300 group-hover:-translate-y-0.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 19V5" />
          <path d="m5 12 7-7 7 7" />
        </svg>
      </a>
    </div>

  </div>
</footer>
