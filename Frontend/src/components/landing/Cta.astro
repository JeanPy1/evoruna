<section
  id="cta"
  data-theme="dark"
  class="navy-gradient relative overflow-hidden py-24 text-white sm:py-28"
>

  <!-- Fondos -->
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">

    <!-- Brillo rojo central -->
    <div
      class="absolute -top-40 left-1/2 h-[30rem] w-[60rem] -translate-x-1/2 rounded-full bg-electric/12 blur-[140px]"
    ></div>

    <!-- Brillo neón lateral -->
    <div
      class="absolute -bottom-48 right-[-12rem] h-[24rem] w-[36rem] rounded-full bg-neon/8 blur-[130px]"
    ></div>

    <!-- Grilla con máscara radial -->
    <div
      class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.04)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.04)_1px,transparent_1px)] bg-[size:56px_56px] [mask-image:radial-gradient(ellipse_62%_62%_at_50%_38%,black_30%,transparent_78%)] [-webkit-mask-image:radial-gradient(ellipse_62%_62%_at_50%_38%,black_30%,transparent_78%)]"
    ></div>

  </div>

  <div class="container-x relative text-center">

    <!-- Hairline superior -->
    <span
      class="absolute inset-x-10 top-0 h-px bg-gradient-to-r from-transparent via-electric/45 to-transparent"
      aria-hidden="true"
    ></span>

    <!-- Heading -->
    <h2
      class="mx-auto mt-8 max-w-3xl font-display text-[2.7rem] leading-[1.02] font-extrabold tracking-[-0.035em] sm:text-[4.6rem]"
    >
      Tu marca, lista
      <span class="block text-electric-gradient">para ser encontrada</span>
    </h2>

    <!-- Descripción -->
    <p
      class="mx-auto mt-6 max-w-2xl text-base leading-7 text-slate-400 sm:text-[1.05rem]"
    >
      Nosotros diseñamos, publicamos y mantenemos tu sitio. Tú te ocupas del
      negocio.
    </p>

    <!-- Acciones -->
    <div
      class="mt-11 flex flex-col items-center justify-center gap-3 sm:flex-row"
    >

      <!-- Primario -->
      <a
        href="/register"
        class="btn-primary group !px-8 !py-3.5 !text-[1.02rem] sm:!w-auto"
      >
        Empezar ahora

        <svg
          class="size-[18px] transition-transform duration-300 group-hover:translate-x-1"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 5l7 7-7 7M5 12h14" />
        </svg>
      </a>

      <!-- Secundario -->
      <a
        href="#pricing"
        class="btn-ghost-dark group !px-8 !py-3.5 !text-[1.02rem] sm:!w-auto"
      >
        Ver planes
      </a>

    </div>

    <!-- Nota discreta -->
    <p
      class="mt-12 text-[0.82rem] font-medium tracking-wide text-slate-500"
    >
      Cobro anual único · Hosting, dominio y correo incluidos
    </p>

  </div>
</section>
