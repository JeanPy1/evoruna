<style>
  
  .loader {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .spinner {
    width: 42px;
    height: 42px;
    border: 3px solid rgba(99, 102, 241, 0.15);
    border-top-color: rgb(79 70 229);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

</style>

<div id="loader" class="loader">
  <div class="spinner"></div>
</div>
