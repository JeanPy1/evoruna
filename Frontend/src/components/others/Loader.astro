<style>

  /* El loader vive dentro del AuthShell (fondo navy): se centra en la
     franja de contenido en vez de ocupar su propia pantalla completa. */
  .loader {
    width: 100%;
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .spinner {
    width: 42px;
    height: 42px;
    border: 3px solid rgba(255, 255, 255, 0.12);
    border-top-color: hsl(0 84% 50%);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

</style>

<div id="loader" class="loader">
  <div class="spinner"></div>
</div>
