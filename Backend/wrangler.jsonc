{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "evoruna",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-02",

  "assets": {
    "directory": "../Frontend/dist",
    "binding": "ASSETS"
  },

  "vars": {
    // URL pública del sitio (sin barra al final): se usa para los links de
    // verificación/reset de email y el flag Secure de la cookie de sesión.
    // En desarrollo local, wrangler dev la sobreescribe con .dev.vars si existe.
    "APP_URL": "https://evoruna.com",
    "RESEND_FROM": "Evoruna <no-reply@evoruna.com>"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "evoruna",
      "database_id": "f956e842-5e32-41d5-9b54-3ce1dd7c2bcc"
    }
  ]
}
