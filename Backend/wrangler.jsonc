{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "evoruna",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-02",

  "assets": {
    "directory": "../Frontend/dist",
    "binding": "ASSETS"
  },

  "vars": {
    // En desarrollo local apunta al Worker de wrangler dev;
    // en producción, reemplaza por la URL pública de tu dominio (sin barra al final)
    "APP_URL": "http://localhost:8787",
    "RESEND_FROM": "Evoruna <no-reply@evoruna.com>"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "evoruna",
      // REEMPLAZA este id por el que imprima `npx wrangler d1 create evoruna`
      "database_id": "PASTE_DATABASE_ID_AQUI"
    }
  ]
}
