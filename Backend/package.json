{
  "name": "Backend",
  "type": "module",
  "scripts": {
    "build:frontend": "npm --prefix ../Frontend run build",
    "dev": "npm run build:frontend && wrangler dev",
    "deploy": "npm run build:frontend && wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "hono": "^4.13.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260830.1",
    "typescript": "^5.8.3",
    "wrangler": "^4.110.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260831.1": true
  }
}
